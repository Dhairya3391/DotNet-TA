@{
    ViewData["Title"] = "ViewData Demo";
}

<div class="text-center">
    <h1 class="display-4">ViewData Demonstration</h1>
    <p>Understanding ViewData data transfer in ASP.NET Core MVC</p>
</div>

<div class="container mt-4">
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">ViewData Dictionary Entries</h5>
                </div>
                <div class="card-body">
                    <table class="table table-striped">
                        <tr>
                            <th>Key</th>
                            <th>Value</th>
                            <th>Data Type</th>
                        </tr>
                        <tr>
                            <td>ViewData["Message"]</td>
                            <td>@ViewData["Message"]</td>
                            <td>@ViewData["Message"]?.GetType().Name</td>
                        </tr>
                        <tr>
                            <td>ViewData["CurrentTime"]</td>
                            <td>@ViewData["CurrentTime"]</td>
                            <td>@ViewData["CurrentTime"]?.GetType().Name</td>
                        </tr>
                        <tr>
                            <td>ViewData["Student"]</td>
                            <td>Dynamic Object</td>
                            <td>@ViewData["Student"]?.GetType().Name</td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container mt-4">
    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Student Information (Type Casting Required)</h5>
                </div>
                <div class="card-body">
                    @{
                        var student = ViewData["Student"] as dynamic;
                    }
                    <ul class="list-unstyled">
                        <li><strong>Name:</strong> @student.Name</li>
                        <li><strong>Age:</strong> @student.Age years</li>
                        <li><strong>Grade:</strong>
                            <span class="badge bg-warning text-dark">@student.Grade</span>
                        </li>
                        <li><strong>Status:</strong>
                            @{
                                if (student.Grade.ToString().Contains("+"))
                                {
                                    <span class="text-success">Above Average</span>
                                }
                                else
                                {
                                    <span class="text-info">Good</span>
                                }
                            }
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0">System Information</h5>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled">
                        <li><strong>Message:</strong> @ViewData["Message"]</li>
                        <li><strong>Current Time:</strong> @ViewData["CurrentTime"]</li>
                        @{
                            var time = ViewData["CurrentTime"] as DateTime?;
                        }
                        <li><strong>Formatted Date:</strong> @time?.ToString("dd-MM-yyyy")</li>
                        <li><strong>Formatted Time:</strong> @time?.ToString("HH:mm:ss")</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container mt-4">
    <div class="alert alert-warning">
        <h5>About ViewData</h5>
        <ul>
            <li>ViewData is a Dictionary&lt;string, object&gt; for passing data from Controller to View</li>
            <li>Requires type casting for complex data types</li>
            <li>Data is only available for the current request</li>
            <li>String-based keys - no compile-time checking</li>
            <li>Null values need to be handled with proper casting</li>
        </ul>
    </div>
</div>

<div class="container mt-4">
    <div class="card">
        <div class="card-header bg-light">
            <h5 class="mb-0">ViewData vs ViewBag Comparison</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <h6>ViewBag</h6>
                    <ul>
                        <li>Dynamic properties</li>
                        <li>No type casting needed</li>
                        <li>Runtime checking only</li>
                        <li>@ViewBag.Message</li>
                    </ul>
                </div>
                <div class="col-md-6">
                    <h6>ViewData</h6>
                    <ul>
                        <li>Dictionary-based</li>
                        <li>Type casting required</li>
                        <li>String keys</li>
                        <li>@ViewData["Message"]</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="text-center mt-4">
    <a asp-action="Index" class="btn btn-primary">Back to Home</a> |
    <a asp-action="ViewBagDemo" class="btn btn-outline-primary">ViewBag Demo</a> |
    <a asp-action="SetTempData" class="btn btn-outline-success">TempData Demo</a>
</div>
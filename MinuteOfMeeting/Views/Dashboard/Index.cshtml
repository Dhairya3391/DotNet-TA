@model MinuteOfMeeting.Controllers.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["PageTitle"] = "Dashboard";
    ViewData["PageDescription"] = "Meeting management overview and analytics";
}

<!-- Dashboard Actions -->
<div class="level mb-4">
    <div class="level-left">
        <div>
            <h4 class="title is-4">Meeting Dashboard</h4>
            <p class="subtitle is-6 has-text-grey">Welcome back! Here's what's happening with your meetings.</p>
        </div>
    </div>
    <div class="level-right">
        <div class="buttons">
            <button class="button is-info" onclick="refreshDashboard()">
                <span class="icon">
                    <i class="fas fa-sync-alt"></i>
                </span>
                <span>Refresh</span>
            </button>
            <button class="button is-success" onclick="exportDashboard()">
                <span class="icon">
                    <i class="fas fa-download"></i>
                </span>
                <span>Export Report</span>
            </button>
        </div>
    </div>
</div>

<!-- Quick Stats Cards -->
<div class="columns mb-6">
    <div class="column is-3-desktop is-6-tablet is-12-mobile">
        <div class="card">
            <div class="card-content">
                <div class="media">
                    <div class="media-left">
                        <figure class="image is-48x48">
                            <div class="tag is-primary is-large">
                                <span class="icon">
                                    <i class="fas fa-calendar-event"></i>
                                </span>
                            </div>
                        </figure>
                    </div>
                    <div class="media-content">
                        <p class="title is-4">@Model.TotalMeetings</p>
                        <p class="subtitle is-6">Total Meetings</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="column is-3-desktop is-6-tablet is-12-mobile">
        <div class="card">
            <div class="card-content">
                <div class="media">
                    <div class="media-left">
                        <figure class="image is-48x48">
                            <div class="tag is-success is-large">
                                <span class="icon">
                                    <i class="fas fa-calendar-plus"></i>
                                </span>
                            </div>
                        </figure>
                    </div>
                    <div class="media-content">
                        <p class="title is-4">@Model.UpcomingMeetings</p>
                        <p class="subtitle is-6">Upcoming</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="column is-3-desktop is-6-tablet is-12-mobile">
        <div class="card">
            <div class="card-content">
                <div class="media">
                    <div class="media-left">
                        <figure class="image is-48x48">
                            <div class="tag is-info is-large">
                                <span class="icon">
                                    <i class="fas fa-check-circle"></i>
                                </span>
                            </div>
                        </figure>
                    </div>
                    <div class="media-content">
                        <p class="title is-4">@Model.CompletedMeetings</p>
                        <p class="subtitle is-6">Completed</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="column is-3-desktop is-6-tablet is-12-mobile">
        <div class="card">
            <div class="card-content">
                <div class="media">
                    <div class="media-left">
                        <figure class="image is-48x48">
                            <div class="tag is-warning is-large">
                                <span class="icon">
                                    <i class="fas fa-times-circle"></i>
                                </span>
                            </div>
                        </figure>
                    </div>
                    <div class="media-content">
                        <p class="title is-4">@Model.CancelledMeetings</p>
                        <p class="subtitle is-6">Cancelled</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Charts Section -->
<div class="columns mb-6">
    <!-- Meetings by Type Chart -->
    <div class="column is-6">
        <div class="card">
            <header class="card-header">
                <p class="card-header-title">
                    <span class="icon">
                        <i class="fas fa-chart-pie"></i>
                    </span>
                    Meetings by Type
                </p>
            </header>
            <div class="card-content">
                <div class="chart-container" style="position: relative; height: 300px;">
                    <canvas id="meetingsByTypeChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Meetings by Department Chart -->
    <div class="column is-6">
        <div class="card">
            <header class="card-header">
                <p class="card-header-title">
                    <span class="icon">
                        <i class="fas fa-chart-bar"></i>
                    </span>
                    Meetings by Department
                </p>
            </header>
            <div class="card-content">
                <div class="chart-container" style="position: relative; height: 300px;">
                    <canvas id="meetingsByDepartmentChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Monthly Trend and Active Departments -->
<div class="columns mb-6">
    <!-- Monthly Meeting Trend -->
    <div class="column is-8">
        <div class="card">
            <header class="card-header">
                <p class="card-header-title">
                    <span class="icon">
                        <i class="fas fa-chart-line"></i>
                    </span>
                    Monthly Meeting Trend
                </p>
                <div class="buttons are-small">
                    <button class="button is-outlined" onclick="changeTrendPeriod('6m')">6M</button>
                    <button class="button is-info" onclick="changeTrendPeriod('1y')">1Y</button>
                    <button class="button is-outlined" onclick="changeTrendPeriod('all')">All</button>
                </div>
            </header>
            <div class="card-content">
                <div class="chart-container">
                    <canvas id="monthlyTrendChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Most Active Departments -->
    <div class="column is-4">
        <div class="card">
            <header class="card-header">
                <p class="card-header-title">
                    <span class="icon">
                        <i class="fas fa-trophy"></i>
                    </span>
                    Most Active Departments
                </p>
            </header>
            <div class="card-content">
                @if (Model?.MostActiveDepartments != null && Model.MostActiveDepartments.Rows.Count > 0)
                {
                    int rank = 1;
                    foreach (System.Data.DataRow row in Model.MostActiveDepartments.Rows)
                    {
                        <div class="media mb-4">
                            <div class="media-left">
                                <figure class="image is-32x32">
                                    <div class="tag is-primary is-rounded" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                                        @rank
                                    </div>
                                </figure>
                            </div>
                            <div class="media-content">
                                <p class="has-text-weight-semibold">@row["DepartmentName"]</p>
                                <p class="has-text-grey is-size-7">@row["MeetingCount"] meetings</p>
                            </div>
                        </div>
                        rank++;
                    }
                }
                else
                {
                    <div class="has-text-centered py-4">
                        <span class="icon has-text-grey">
                            <i class="fas fa-inbox fa-2x"></i>
                        </span>
                        <p class="has-text-grey">No data available</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Recent and Upcoming Meetings -->
<div class="columns">
    <!-- Recent Meetings -->
    <div class="column is-6">
        <div class="card">
            <header class="card-header">
                <p class="card-header-title">
                    <span class="icon">
                        <i class="fas fa-clock"></i>
                    </span>
                    Recent Meetings
                </p>
            </header>
            <div class="card-content">
                @if (Model?.RecentMeetings != null && Model.RecentMeetings.Rows.Count > 0)
                {
                    foreach (System.Data.DataRow row in Model.RecentMeetings.Rows)
                    {
                        <div class="box is-small mb-3">
                            <div class="media">
                                <div class="media-content">
                                    <p class="has-text-weight-semibold">@row["MeetingDescription"]</p>
                                    <p class="has-text-grey is-size-7">@row["DepartmentName"]</p>
                                    <div class="level is-mobile mt-2">
                                        <div class="level-left">
                                            <div class="level-item">
                                                <span class="icon is-small">
                                                    <i class="fas fa-calendar"></i>
                                                </span>
                                                <small>@Convert.ToDateTime(row["MeetingDate"]).ToString("MMM dd, HH:mm")</small>
                                            </div>
                                        </div>
                                        <div class="level-right">
                                            @if (Convert.ToBoolean(row["IsCancelled"]))
                                            {
                                                <span class="tag is-danger">Cancelled</span>
                                            }
                                            else if (Convert.ToDateTime(row["MeetingDate"]) < DateTime.Now)
                                            {
                                                <span class="tag is-success">Completed</span>
                                            }
                                            else
                                            {
                                                <span class="tag is-warning">Upcoming</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="has-text-centered py-4">
                        <span class="icon has-text-grey">
                            <i class="fas fa-history fa-2x"></i>
                        </span>
                        <p class="has-text-grey">No recent meetings found</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Upcoming Meetings -->
    <div class="column is-6">
        <div class="card">
            <header class="card-header">
                <p class="card-header-title">
                    <span class="icon">
                        <i class="fas fa-calendar-alt"></i>
                    </span>
                    Upcoming Meetings
                </p>
                <a href="@Url.Action("Create", "Meeting")" class="card-header-icon">
                    <span class="icon has-text-success">
                        <i class="fas fa-plus"></i>
                    </span>
                </a>
            </header>
            <div class="card-content">
                @if (Model?.UpcomingMeetingsList != null && Model.UpcomingMeetingsList.Rows.Count > 0)
                {
                    foreach (System.Data.DataRow row in Model.UpcomingMeetingsList.Rows)
                    {
                        <div class="box is-small mb-3">
                            <div class="media">
                                <div class="media-content">
                                    <p class="has-text-weight-semibold">@row["MeetingDescription"]</p>
                                    <p class="has-text-grey is-size-7">@row["DepartmentName"]</p>
                                    <div class="level is-mobile mt-2">
                                        <div class="level-left">
                                            <div class="level-item">
                                                <span class="icon is-small">
                                                    <i class="fas fa-calendar"></i>
                                                </span>
                                                <small>@Convert.ToDateTime(row["MeetingDate"]).ToString("MMM dd, HH:mm")</small>
                                            </div>
                                        </div>
                                        <div class="level-right">
                                            <div class="level-item">
                                                <span class="icon is-small">
                                                    <i class="fas fa-map-marker-alt"></i>
                                                </span>
                                                <small>@row["MeetingVenueName"]</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="media-right">
                                    <a href="/Meeting/Details/@row["MeetingID"]" class="button is-small is-info is-outlined">
                                        <span class="icon">
                                            <i class="fas fa-eye"></i>
                                        </span>
                                        <span>View</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="has-text-centered py-4">
                        <span class="icon has-text-grey">
                            <i class="fas fa-calendar-plus fa-2x"></i>
                        </span>
                        <p class="has-text-grey">No upcoming meetings scheduled</p>
                        <a href="@Url.Action("Create", "Meeting")" class="button is-primary is-small mt-3">
                            <span class="icon">
                                <i class="fas fa-plus"></i>
                            </span>
                            <span>Schedule Meeting</span>
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let charts = {};

        // Pre-load chart data from server
        const chartDataRaw = {
            meetingsByType: @Html.Raw(ViewBag.MeetingsByTypeJson ?? "[]"),
            meetingsByDepartment: @Html.Raw(ViewBag.MeetingsByDepartmentJson ?? "[]"),
            monthlyTrend: @Html.Raw(ViewBag.MonthlyTrendJson ?? "[]")
        };

        // Extract data for charts
        const meetingsByTypeData = chartDataRaw.meetingsByType.map(item => ({
            MeetingTypeName: item.MeetingTypeName || "",
            Count: parseInt(item.Count) || 0
        }));

        const meetingsByDepartmentData = chartDataRaw.meetingsByDepartment.map(item => ({
            DepartmentName: item.DepartmentName || "",
            Count: parseInt(item.Count) || 0
        }));

        const monthlyTrendData = chartDataRaw.monthlyTrend.map(item => ({
            Month: item.Month || "",
            Count: parseInt(item.Count) || 0
        }));

        document.addEventListener('DOMContentLoaded', function() {
            // Wait for Chart.js to load
            if (typeof Chart === 'undefined') {
                setTimeout(initializeCharts, 100);
            } else {
                initializeCharts();
            }

            // Auto-refresh stats every 60 seconds
            setInterval(refreshQuickStats, 60000);
        });

        function initializeCharts() {
            if (typeof Chart === 'undefined') {
                console.log('Chart.js not loaded yet, retrying...');
                setTimeout(initializeCharts, 100);
                return;
            }

            // Meetings by Type - Doughnut Chart
            const meetingsByTypeCtx = document.getElementById('meetingsByTypeChart');
            if (meetingsByTypeCtx) {
                charts.meetingsByType = window.UIManager.createChart('meetingsByTypeChart', 'doughnut', {
                    labels: meetingsByTypeData.map(x => x.MeetingTypeName),
                    datasets: [{
                        data: meetingsByTypeData.map(x => x.Count),
                        backgroundColor: [
                            '#00d1b2',
                            '#48c774',
                            '#3298dc',
                            '#ffdd57',
                            '#ff3860',
                            '#b86bff'
                        ],
                        borderWidth: 2
                    }]
                });
            }

            // Meetings by Department - Bar Chart
            const meetingsByDeptCtx = document.getElementById('meetingsByDepartmentChart');
            if (meetingsByDeptCtx) {
                charts.meetingsByDepartment = window.UIManager.createChart('meetingsByDepartmentChart', 'bar', {
                    labels: meetingsByDepartmentData.map(x => x.DepartmentName),
                    datasets: [{
                        label: 'Number of Meetings',
                        data: meetingsByDepartmentData.map(x => x.Count),
                        backgroundColor: '#00d1b2',
                        borderColor: '#00b89c',
                        borderWidth: 1
                    }]
                }, {
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                stepSize: 1
                            }
                        }
                    }
                });
            }

            // Monthly Trend - Line Chart
            const monthlyTrendCtx = document.getElementById('monthlyTrendChart');
            if (monthlyTrendCtx) {
                charts.monthlyTrend = window.UIManager.createChart('monthlyTrendChart', 'line', {
                    labels: monthlyTrendData.map(x => x.Month),
                    datasets: [{
                        label: 'Meetings',
                        data: monthlyTrendData.map(x => x.Count),
                        borderColor: '#00d1b2',
                        backgroundColor: 'rgba(0, 209, 178, 0.1)',
                        borderWidth: 2,
                        fill: true,
                        tension: 0.4
                    }]
                }, {
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                stepSize: 1
                            }
                        }
                    }
                });
            }
        }

        function refreshQuickStats() {
            fetch('/Dashboard/QuickStats')
                .then(response => response.json())
                .then(response => {
                    if (!response.error) {
                        document.getElementById('totalMeetingsStat').textContent = response.totalMeetings;
                        document.getElementById('upcomingMeetingsStat').textContent = response.upcomingMeetings;
                        document.getElementById('completedMeetingsStat').textContent = response.completedMeetings || 0;
                        document.getElementById('cancelledMeetingsStat').textContent = response.cancelledMeetings || 0;
                    }
                })
                .catch(error => console.error('Error refreshing stats:', error));
        }

        function refreshChart(chartType) {
            const endpoint = chartType === 'meetingsByType' ?
                '/Dashboard/GetChartData?charttype=meetingsbytype' :
                '/Dashboard/GetChartData?charttype=meetingsbydepartment';

            fetch(endpoint)
                .then(response => response.json())
                .then(response => {
                    if (!response.error && Array.isArray(response)) {
                        const chart = charts[chartType];
                        chart.data.labels = chartType === 'meetingsByType' ?
                            response.map(item => item.MeetingTypeName) :
                            response.map(item => item.DepartmentName);
                        chart.data.datasets[0].data = response.map(item => item.Count);
                        chart.update();
                    }
                })
                .catch(error => console.error('Error refreshing chart:', error));
        }

        function refreshDashboard() {
            window.location.reload();
        }

        function changeTrendPeriod(period) {
            // Update button states
            document.querySelectorAll('.card-header .button').forEach(btn => {
                btn.classList.remove('is-info');
                btn.classList.add('is-outlined');
            });
            event.target.classList.remove('is-outlined');
            event.target.classList.add('is-info');

            // Reload trend data
            fetch('/Dashboard/GetChartData?charttype=monthlytrend&period=' + period)
                .then(response => response.json())
                .then(response => {
                    if (!response.error && Array.isArray(response)) {
                        charts.monthlyTrend.data.labels = response.map(item => item.Month);
                        charts.monthlyTrend.data.datasets[0].data = response.map(item => item.Count);
                        charts.monthlyTrend.update();
                    }
                })
                .catch(error => console.error('Error changing trend period:', error));
        }

        function downloadChart(chartId) {
            const canvas = document.getElementById(chartId);
            if (canvas) {
                const url = canvas.toDataURL('image/png');
                const link = document.createElement('a');
                link.download = chartId + '_' + new Date().toISOString().slice(0, 10) + '.png';
                link.href = url;
                link.click();
            }
        }

        function exportDashboard() {
            window.UIManager.showNotification('Dashboard export functionality would generate a comprehensive PDF report with all charts and statistics.', 'info');
        }
    </script>
}
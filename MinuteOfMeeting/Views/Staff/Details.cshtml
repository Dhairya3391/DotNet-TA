@using System.Data
@model DataTable
@{
    ViewData["Title"] = "Staff Member Details";
    ViewData["PageTitle"] = "Staff Member Details";
    ViewData["PageDescription"] = "View detailed information about this staff member";

    var hasData = Model != null && Model.Rows.Count > 0;
    var staffId = 0;
    var staffName = string.Empty;
    var departmentId = 0;
    var departmentName = string.Empty;
    var mobileNo = string.Empty;
    var emailAddress = string.Empty;
    var remarks = string.Empty;
    DateTime created = DateTime.MinValue;
    DateTime modified = DateTime.MinValue;

    if (hasData)
    {
        DataRow row = Model!.Rows[0];
        staffId = Convert.ToInt32(row["StaffID"]);
        staffName = row["StaffName"].ToString();
        departmentId = Convert.ToInt32(row["DepartmentID"]);
        departmentName = row["DepartmentName"].ToString();
        mobileNo = row["MobileNo"].ToString();
        emailAddress = row["EmailAddress"].ToString();
        remarks = row["Remarks"].ToString();
        created = Convert.ToDateTime(row["Created"]);
        modified = Convert.ToDateTime(row["Modified"]);
    }
}

@if (!hasData)
{
    <div class="alert alert-warning">
        Unable to find details for this staff member.
    </div>
}
else
{
<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="bi bi-person me-2"></i>
                    Staff Member Information
                </h5>
                <div class="btn-group" role="group">
                    <a asp-action="AddEdit" asp-route-id="@staffId" class="btn btn-outline-warning btn-sm">
                        <i class="bi bi-pencil me-1"></i>Edit
                    </a>
                    <button type="button" class="btn btn-outline-danger btn-sm"
                            onclick="confirmDelete(@staffId, '@staffName')">
                        <i class="bi bi-trash me-1"></i>Delete
                    </button>
                </div>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="form-label text-muted">Staff ID</label>
                        <p class="form-control-plaintext fw-bold">@staffId</p>
                    </div>
                    <div class="col-md-8">
                        <label class="form-label text-muted">Staff Name</label>
                        <p class="form-control-plaintext">
                            <span class="badge bg-primary fs-6">@staffName</span>
                        </p>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label text-muted">Department</label>
                        <p class="form-control-plaintext">
                            <i class="bi bi-building me-2"></i>
                            @departmentName
                        </p>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted">Email Address</label>
                        <p class="form-control-plaintext">
                            <i class="bi bi-envelope me-2"></i>
                            <a href="mailto:@emailAddress">@emailAddress</a>
                        </p>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted">Mobile Number</label>
                    <p class="form-control-plaintext">
                        <i class="bi bi-phone me-2"></i>
                        @mobileNo
                    </p>
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted">Remarks</label>
                    <p class="form-control-plaintext">
                        @if (!string.IsNullOrEmpty(remarks))
                        {
                            @remarks
                        }
                        else
                        {
                            <span class="text-muted">No remarks provided</span>
                        }
                    </p>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <label class="form-label text-muted">Created Date</label>
                        <p class="form-control-plaintext">
                            <i class="bi bi-calendar-plus me-2"></i>
                            @created.ToString("yyyy-MM-dd HH:mm:ss")
                        </p>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted">Last Modified</label>
                        <p class="form-control-plaintext">
                            <i class="bi bi-calendar-check me-2"></i>
                            @modified.ToString("yyyy-MM-dd HH:mm:ss")
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0">
                    <i class="bi bi-bar-chart me-2"></i>
                    Meeting Statistics
                </h6>
            </div>
            <div class="card-body">
                <div class="text-center mb-3">
                    <h2 class="text-primary mb-1" id="totalMeetingsCount">-</h2>
                    <small class="text-muted">Total Meetings</small>
                </div>

                <div class="row text-center">
                    <div class="col-6">
                        <div class="p-2">
                            <h5 class="text-success mb-1" id="attendedCount">-</h5>
                            <small class="text-muted">Attended</small>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-2">
                            <h5 class="text-info mb-1" id="upcomingCount">-</h5>
                            <small class="text-muted">Upcoming</small>
                        </div>
                    </div>
                </div>

                <hr>

                <div class="text-center">
                    <h4 class="text-warning mb-1" id="attendanceRate">-%</h4>
                    <small class="text-muted">Attendance Rate</small>
                </div>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header">
                <h6 class="mb-0">
                    <i class="bi bi-calendar-week me-2"></i>
                    Recent Meetings
                </h6>
            </div>
            <div class="card-body">
                <div id="recentMeetings">
                    <div class="text-center text-muted">
                        <div class="spinner-border spinner-border-sm me-2"></div>
                        Loading recent meetings...
                    </div>
                </div>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header">
                <h6 class="mb-0">
                    <i class="bi bi-lightning me-2"></i>
                    Quick Actions
                </h6>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a asp-action="Meetings" asp-route-id="@staffId" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-calendar-event me-2"></i>
                        View All Meetings
                    </a>
                    <a href="/Department/StaffMembers?id=@departmentId" class="btn btn-outline-info btn-sm">
                        <i class="bi bi-people me-2"></i>
                        View Department
                    </a>
                    <a href="mailto:@emailAddress" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-envelope me-2"></i>
                        Send Email
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-arrow-left me-2"></i>
                        Back to List
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete the staff member: <strong id="deleteItemName"></strong>?</p>
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    <strong>Warning:</strong> This action cannot be undone. Make sure this staff member is not:
                    <ul class="mb-0">
                        <li>Assigned to any meetings</li>
                        <li>Associated with a user account</li>
                    </ul>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form method="post" asp-action="Delete" style="display: inline;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteItemId" />
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-2"></i>Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

}

@section Scripts {
    <script>
        $(document).ready(function() {
            loadStaffStatistics();
            loadRecentMeetings();
        });

        function loadStaffStatistics() {
            $.post('/Staff/GetStaffStatistics', { staffId: @staffId }, function(data) {
                if (!data.error) {
                    $('#totalMeetingsCount').text(data.totalMeetings || 0);
                    $('#attendedCount').text(data.attendedMeetings || 0);
                    $('#upcomingCount').text(data.upcomingMeetings || 0);
                    $('#attendanceRate').text((data.attendanceRate || 0).toFixed(1) + '%');
                }
            }).fail(function() {
                $('#totalMeetingsCount').text('0');
                $('#attendedCount').text('0');
                $('#upcomingCount').text('0');
                $('#attendanceRate').text('0%');
            });
        }

        function loadRecentMeetings() {
            setTimeout(function() {
                var html = '<div class="list-group list-group-flush">';
                html += '<div class="list-group-item px-0 small">Jan 25 - Team Meeting</div>';
                html += '<div class="list-group-item px-0 small">Jan 22 - Project Review</div>';
                html += '<div class="list-group-item px-0 small">Jan 20 - Training Session</div>';
                html += '</div>';
                html += '<div class="mt-2"><a asp-action="Meetings" asp-route-id="@staffId" class="btn btn-link btn-sm">View All →</a></div>';
                $('#recentMeetings').html(html);
            }, 1000);
        }

        function confirmDelete(id, name) {
            $('#deleteItemId').val(id);
            $('#deleteItemName').text(name);
            var modal = new bootstrap.Modal(document.getElementById('deleteModal'));
            modal.show();
        }
    </script>
}

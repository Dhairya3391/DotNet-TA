@using System.Data
@model DataTable
@{
    ViewData["Title"] = "Staff Members";
    ViewData["PageTitle"] = "Staff Members";
    ViewData["PageDescription"] = "Manage staff members and their meeting participation";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1">Staff Management</h4>
        <p class="text-muted mb-0">Manage staff members across all departments</p>
    </div>
    <div>
        <a asp-action="AddEdit" class="btn btn-primary">
            <i class="bi bi-person-plus me-2"></i>Add Staff Member
        </a>
        <button type="button" class="btn btn-success" onclick="exportToExcel()">
            <i class="bi bi-file-earmark-excel me-2"></i>Export
        </button>
    </div>
</div>

<!-- Search and Filter Bar -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-3">
                <select name="departmentId" class="form-select" asp-items="@(ViewBag.Departments as SelectList)">
                    <option value="">All Departments</option>
                </select>
            </div>
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" name="searchText" class="form-control"
                           placeholder="Search staff..." value="@ViewData["SearchText"]" />
                    <button type="submit" class="btn btn-outline-primary">Search</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
                </div>
            </div>
            <div class="col-md-3 text-end">
                <span class="text-muted">
                    Total: @(Model?.Rows.Count ?? 0)
                </span>
            </div>
        </form>
    </div>
</div>

<!-- Staff Table -->
<div class="card">
    <div class="card-header">
        <h5 class="mb-0">
            <i class="bi bi-people me-2"></i>
            Staff Members List
        </h5>
    </div>
    <div class="card-body">
        @if (Model != null && Model.Rows.Count > 0)
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th width="80">#</th>
                            <th>Staff Name</th>
                            <th>Department</th>
                            <th>Mobile Number</th>
                            <th>Email Address</th>
                            <th width="120">Total Meetings</th>
                            <th width="120">Attendance Rate</th>
                            <th width="150">Created Date</th>
                            <th width="120" class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (DataRow row in Model.Rows)
                        {
                            <tr>
                                <td>@row["StaffID"]</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="bg-primary rounded-circle p-2 text-white me-3" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                                            <i class="bi bi-person"></i>
                                        </div>
                                        <div>
                                            <strong>@row["StaffName"]</strong>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-info">@row["DepartmentName"]</span>
                                </td>
                                <td>
                                    <a href="tel:@row["MobileNo"]" class="text-decoration-none">
                                        <i class="bi bi-telephone me-1"></i>@row["MobileNo"]
                                    </a>
                                </td>
                                <td>
                                    <a href="mailto:@row["EmailAddress"]" class="text-decoration-none">
                                        <i class="bi bi-envelope me-1"></i>@row["EmailAddress"]
                                    </a>
                                </td>
                                <td>
                                    <span class="badge bg-primary staff-meeting-count" data-staff-id="@row["StaffID"]">
                                        Loading...
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-success staff-attendance-rate" data-staff-id="@row["StaffID"]">
                                        Loading...
                                    </span>
                                </td>
                                <td>
                                    <small class="text-muted">
                                        @Convert.ToDateTime(row["Created"]).ToString("yyyy-MM-dd")
                                    </small>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group" role="group">
                                        <a asp-action="Details" asp-route-id="@row["StaffID"]" class="btn btn-sm btn-outline-primary" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Meetings" asp-route-id="@row["StaffID"]" class="btn btn-sm btn-outline-info" title="View Meetings">
                                            <i class="bi bi-calendar-event"></i>
                                        </a>
                                        <a asp-action="AddEdit" asp-route-id="@row["StaffID"]" class="btn btn-sm btn-outline-warning" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="confirmDelete(@row["StaffID"], '@row["StaffName"]')" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-people text-muted" style="font-size: 3rem;"></i>
                <h5 class="text-muted mt-3">No Staff Members Found</h5>
                <p class="text-muted">Get started by adding your first staff member.</p>
                <a asp-action="AddEdit" class="btn btn-primary">
                    <i class="bi bi-person-plus me-2"></i>Add First Staff Member
                </a>
            </div>
        }
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete the staff member: <strong id="deleteItemName"></strong>?</p>
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    <strong>Warning:</strong> This action cannot be undone.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form method="post" asp-action="Delete" style="display: inline;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteItemId" />
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            loadStaffStatistics();
        });

        function loadStaffStatistics() {
            $('.staff-meeting-count, .staff-attendance-rate').each(function() {
                var element = $(this);
                var staffId = element.data('staff-id');

                $.post('/Staff/GetStaffStatistics', { staffId: staffId }, function(response) {
                    if (!response.error) {
                        if (element.hasClass('staff-meeting-count')) {
                            element.text(response.totalMeetings || 0);
                        } else if (element.hasClass('staff-attendance-rate')) {
                            var rate = response.attendanceRate || 0;
                            element.text(rate.toFixed(1) + '%');
                        }
                    }
                });
            });
        }

        function confirmDelete(id, name) {
            $('#deleteItemId').val(id);
            $('#deleteItemName').text(name);
            var modal = new bootstrap.Modal(document.getElementById('deleteModal'));
            modal.show();
        }

        function exportToExcel() {
            window.location.href = '@Url.Action("ExportToExcel")';
        }
    </script>
}
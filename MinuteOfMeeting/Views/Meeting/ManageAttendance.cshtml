@model List<MinuteOfMeeting.Models.ViewModels.MeetingAttendeeViewModel>
@using System.Data
@{
    ViewData["Title"] = "Manage Attendance";
    ViewData["PageTitle"] = "Manage Meeting Attendance";
    ViewData["PageDescription"] = "Track attendance and participation for this meeting";

    DataRow meeting = ViewBag.Meeting as DataRow;
}

<div class="row justify-content-center">
    <div class="col-md-12">
        <!-- Meeting Info Card -->
        <div class="card shadow mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">
                    <i class="bi bi-calendar-event me-2"></i>
                    Meeting Information
                </h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3">
                        <strong>Date & Time:</strong><br>
                        @Convert.ToDateTime(meeting["MeetingDate"]).ToString("MMM dd, yyyy HH:mm")
                    </div>
                    <div class="col-md-3">
                        <strong>Meeting Type:</strong><br>
                        <span class="badge bg-info">@meeting["MeetingTypeName"]</span>
                    </div>
                    <div class="col-md-3">
                        <strong>Department:</strong><br>
                        @meeting["DepartmentName"]
                    </div>
                    <div class="col-md-3">
                        <strong>Venue:</strong><br>
                        @meeting["MeetingVenueName"]
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(meeting["MeetingDescription"].ToString()))
                {
                    <hr>
                    <div>
                        <strong>Description:</strong><br>
                        @meeting["MeetingDescription"]
                    </div>
                }
            </div>
        </div>

        <!-- Attendance Management -->
        <div class="card shadow">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="bi bi-people me-2"></i>
                    Attendance Management
                </h5>
            </div>
            <div class="card-body">
                <form asp-action="UpdateAttendance" method="post" id="attendanceForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="meetingId" value="@meeting["MeetingID"]" />

                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th width="50">
                                        <input type="checkbox" id="selectAll" class="form-check-input" />
                                    </th>
                                    <th>Staff Name</th>
                                    <th>Email Address</th>
                                    <th width="120">Attendance</th>
                                    <th>Remarks</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.Count; i++)
                                {
                                    <tr>
                                        <td>
                                            <input type="checkbox" name="selectedStaff" value="@Model[i].StaffID"
                                                   class="form-check-input row-checkbox" @(Model[i].IsInvited ? "checked" : "") />
                                            <input type="hidden" name="selectedStaff" value="@Model[i].StaffID" />
                                        </td>
                                        <td>
                                            <strong>@Model[i].StaffName</strong>
                                        </td>
                                        <td>@Model[i].EmailAddress</td>
                                        <td>
                                            <div class="form-check form-check-inline">
                                                <input class="form-check-input" type="radio" name="attendanceStatus[@i]"
                                                       id="present_@i" value="present"
                                                       @(Model[i].IsPresent ? "checked" : "")>
                                                <label class="form-check-label" for="present_@i">
                                                    <span class="badge bg-success">Present</span>
                                                </label>
                                            </div>
                                            <div class="form-check form-check-inline">
                                                <input class="form-check-input" type="radio" name="attendanceStatus[@i]"
                                                       id="absent_@i" value="absent"
                                                       @(!Model[i].IsPresent && Model[i].IsInvited ? "checked" : "")>
                                                <label class="form-check-label" for="absent_@i">
                                                    <span class="badge bg-danger">Absent</span>
                                                </label>
                                            </div>
                                        </td>
                                        <td>
                                            <input type="text" name="remarks" class="form-control form-control-sm"
                                                   placeholder="Add remarks..." value="@Model[i].Remarks" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <div>
                            <button type="button" class="btn btn-outline-secondary" onclick="selectAllStaff()">
                                <i class="bi bi-check-all me-2"></i>Select All Staff
                            </button>
                            <button type="button" class="btn btn-outline-secondary" onclick="clearSelection()">
                                <i class="bi bi-x-square me-2"></i>Clear Selection
                            </button>
                        </div>
                        <div>
                            <a href="@Url.Action("Details", new { id = meeting["MeetingID"] })" class="btn btn-outline-secondary me-2">
                                <i class="bi bi-arrow-left me-2"></i>Back to Details
                            </a>
                            <button type="submit" class="btn btn-primary" id="saveButton">
                                <i class="bi bi-check-circle me-2"></i>Save Attendance
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Select all checkbox functionality
            $('#selectAll').change(function() {
                $('.row-checkbox').prop('checked', $(this).prop('checked'));
            });

            // Individual checkbox functionality
            $('.row-checkbox').change(function() {
                updateSelectAll();
            });

            // When checkbox is unchecked, also clear attendance status
            $('.row-checkbox').change(function() {
                var row = $(this).closest('tr');
                if (!$(this).prop('checked')) {
                    row.find('input[type="radio"]').prop('checked', false);
                    row.find('input[name="remarks"]').val('');
                }
            });

            // Initialize select all state
            updateSelectAll();
        });

        function updateSelectAll() {
            var totalCheckboxes = $('.row-checkbox').length;
            var checkedCheckboxes = $('.row-checkbox:checked').length;

            if (checkedCheckboxes === 0) {
                $('#selectAll').prop('indeterminate', false).prop('checked', false);
            } else if (checkedCheckboxes === totalCheckboxes) {
                $('#selectAll').prop('indeterminate', false).prop('checked', true);
            } else {
                $('#selectAll').prop('indeterminate', true);
            }
        }

        function selectAllStaff() {
            $('.row-checkbox').prop('checked', true);
            updateSelectAll();
        }

        function clearSelection() {
            $('.row-checkbox').prop('checked', false);
            $('.row-checkbox').each(function() {
                var row = $(this).closest('tr');
                row.find('input[type="radio"]').prop('checked', false);
                row.find('input[name="remarks"]').val('');
            });
            updateSelectAll();
        }

        // Form submission with loading state
        $('#attendanceForm').on('submit', function() {
            var saveBtn = $('#saveButton');
            saveBtn.prop('disabled', true)
                .html('<span class="spinner-border spinner-border-sm me-2"></span>Saving...');

            // Re-enable button after 5 seconds in case of error
            setTimeout(function() {
                saveBtn.prop('disabled', false)
                    .html('<i class="bi bi-check-circle me-2"></i>Save Attendance');
            }, 5000);
        });
    </script>
}
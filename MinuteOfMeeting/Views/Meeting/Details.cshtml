@using System.Data
@model DataTable
@{
    ViewData["Title"] = "Meeting Details";
    ViewData["PageTitle"] = "Meeting Details";
    ViewData["PageDescription"] = "View detailed information about this meeting";

    DataRow meeting = Model.Rows[0];
    DataTable members = ViewBag.Members as DataTable ?? new DataTable();
}

<div class="row justify-content-center">
    <div class="col-md-12">
        <!-- Meeting Details Card -->
        <div class="card shadow mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="bi bi-calendar-event me-2"></i>
                    Meeting Details
                </h5>
                <div>
                    <a asp-action="Edit" asp-route-id="@meeting["MeetingID"]"
                       class="btn btn-sm btn-outline-warning @(Convert.ToBoolean(meeting["IsCancelled"]) || Convert.ToDateTime(meeting["MeetingDate"]) < DateTime.Now ? "disabled" : "")">
                        <i class="bi bi-pencil me-1"></i>Edit
                    </a>
                    <a asp-action="Cancel" asp-route-id="@meeting["MeetingID"]"
                       class="btn btn-sm btn-outline-danger @(Convert.ToBoolean(meeting["IsCancelled"]) || Convert.ToDateTime(meeting["MeetingDate"]) < DateTime.Now ? "disabled" : "")">
                        <i class="bi bi-x-circle me-1"></i>Cancel
                    </a>
                </div>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <table class="table table-borderless">
                            <tr>
                                <td><strong>Meeting ID:</strong></td>
                                <td>@meeting["MeetingID"]</td>
                            </tr>
                            <tr>
                                <td><strong>Date & Time:</strong></td>
                                <td>@Convert.ToDateTime(meeting["MeetingDate"]).ToString("MMMM dd, yyyy 'at' HH:mm")</td>
                            </tr>
                            <tr>
                                <td><strong>Meeting Type:</strong></td>
                                <td><span class="badge bg-info">@meeting["MeetingTypeName"]</span></td>
                            </tr>
                            <tr>
                                <td><strong>Department:</strong></td>
                                <td>@meeting["DepartmentName"]</td>
                            </tr>
                        </table>
                    </div>
                    <div class="col-md-6">
                        <table class="table table-borderless">
                            <tr>
                                <td><strong>Venue:</strong></td>
                                <td>@meeting["MeetingVenueName"]</td>
                            </tr>
                            <tr>
                                <td><strong>Status:</strong></td>
                                <td>
                                    @if (Convert.ToBoolean(meeting["IsCancelled"]))
                                    {
                                        <span class="badge bg-danger">Cancelled</span>
                                    }
                                    else if (Convert.ToDateTime(meeting["MeetingDate"]) < DateTime.Now)
                                    {
                                        <span class="badge bg-secondary">Completed</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Upcoming</span>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Created:</strong></td>
                                <td>@Convert.ToDateTime(meeting["Created"]).ToString("MMM dd, yyyy HH:mm")</td>
                            </tr>
                            <tr>
                                <td><strong>Modified:</strong></td>
                                <td>@Convert.ToDateTime(meeting["Modified"]).ToString("MMM dd, yyyy HH:mm")</td>
                            </tr>
                        </table>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(meeting["MeetingDescription"].ToString()))
                {
                    <hr>
                    <div class="mb-3">
                        <h6><strong>Meeting Description:</strong></h6>
                        <p class="text-muted">@meeting["MeetingDescription"]</p>
                    </div>
                }

                @if (Convert.ToBoolean(meeting["IsCancelled"]))
                {
                    <div class="alert alert-danger">
                        <h6><i class="bi bi-exclamation-triangle me-2"></i>Meeting Cancelled</h6>
                        <p class="mb-0">
                            <strong>Reason:</strong> @meeting["CancellationReason"]<br>
                            <strong>Cancelled on:</strong> @Convert.ToDateTime(meeting["CancellationDateTime"]).ToString("MMMM dd, yyyy 'at' HH:mm")
                        </p>
                    </div>
                }

                @if (!string.IsNullOrEmpty(meeting["DocumentPath"].ToString()))
                {
                    <div class="mb-3">
                        <h6><strong>Meeting Document:</strong></h6>
                        <a href="@Url.Action("DownloadDocument", new { id = meeting["MeetingID"] })"
                           class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-download me-1"></i>Download Document
                        </a>
                    </div>
                }
            </div>
        </div>

        <!-- Attendance Card -->
        <div class="card shadow">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="bi bi-people me-2"></i>
                    Attendance Information
                </h5>
                <a asp-action="ManageAttendance" asp-route-id="@meeting["MeetingID"]"
                   class="btn btn-sm btn-primary">
                    <i class="bi bi-pencil me-1"></i>Manage Attendance
                </a>
            </div>
            <div class="card-body">
                @if (members != null && members.Rows.Count > 0)
                {
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <div class="card bg-light">
                                <div class="card-body text-center">
                                    <h4 class="text-primary">@members.Rows.Count</h4>
                                    <small class="text-muted">Total Participants</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card bg-light">
                                <div class="card-body text-center">
                                    <h4 class="text-success">@members.Select("IsPresent = 1").Length</h4>
                                    <small class="text-muted">Present</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card bg-light">
                                <div class="card-body text-center">
                                    <h4 class="text-danger">@members.Select("IsPresent = 0").Length</h4>
                                    <small class="text-muted">Absent</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Staff Name</th>
                                    <th>Email Address</th>
                                    <th>Mobile Number</th>
                                    <th width="100">Attendance</th>
                                    <th>Remarks</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (DataRow member in members.Rows)
                                {
                                    <tr>
                                        <td>
                                            <strong>@member["StaffName"]</strong>
                                        </td>
                                        <td>@member["EmailAddress"]</td>
                                        <td>@member["MobileNo"]</td>
                                        <td>
                                            @if (Convert.ToBoolean(member["IsPresent"]))
                                            {
                                                <span class="badge bg-success">Present</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">Absent</span>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(member["Remarks"].ToString()))
                                            {
                                                <span>@member["Remarks"]</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">No remarks</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-4">
                        <i class="bi bi-people text-muted" style="font-size: 2rem;"></i>
                        <h6 class="text-muted mt-2">No Participants Added</h6>
                        <p class="text-muted">Manage attendance to add participants to this meeting.</p>
                        <a asp-action="ManageAttendance" asp-route-id="@meeting["MeetingID"]"
                           class="btn btn-sm btn-primary">
                            <i class="bi bi-plus-circle me-1"></i>Add Participants
                        </a>
                    </div>
                }
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="d-flex justify-content-between mt-4">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-2"></i>Back to Meetings
            </a>
            <div>
                <a asp-action="Calendar" class="btn btn-outline-info me-2">
                    <i class="bi bi-calendar me-2"></i>Calendar View
                </a>
                <a asp-action="ManageAttendance" asp-route-id="@meeting["MeetingID"]"
                   class="btn btn-primary">
                    <i class="bi bi-people me-2"></i>Manage Attendance
                </a>
            </div>
        </div>
    </div>
</div>
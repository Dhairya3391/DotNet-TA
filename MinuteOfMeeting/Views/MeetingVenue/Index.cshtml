@using System.Data
@model DataTable
@{
    ViewData["Title"] = "Meeting Venues";
    ViewData["PageTitle"] = "Meeting Venues";
    ViewData["PageDescription"] = "Manage meeting rooms and virtual meeting locations";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1">Venue Management</h4>
        <p class="text-muted mb-0">Configure and track all meeting locations</p>
    </div>
    <div>
        <a asp-action="AddEdit" class="btn btn-primary">
            <i class="bi bi-plus-circle me-2"></i>Add Venue
        </a>
        <button type="button" class="btn btn-success" onclick="exportToExcel()">
            <i class="bi bi-file-earmark-excel me-2"></i>Export
        </button>
    </div>
</div>

<!-- Search and Filter Bar -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-8">
                <div class="input-group">
                    <span class="input-group-text">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" name="searchText" class="form-control"
                           placeholder="Search venues..." value="@ViewData["SearchText"]" />
                    <button type="submit" class="btn btn-outline-primary">Search</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
                </div>
            </div>
            <div class="col-md-4 text-end">
                <span class="text-muted">
                    Total Venues: @(Model?.Rows.Count ?? 0)
                </span>
            </div>
        </form>
    </div>
</div>

<!-- Venues Grid -->
@if (Model != null && Model.Rows.Count > 0)
{
    <div class="row">
        @foreach (DataRow row in Model.Rows)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 venue-card" data-venue-id="@row["MeetingVenueID"]">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h6 class="mb-0">
                            <i class="bi bi-geo-alt me-2"></i>
                            @row["MeetingVenueName"]
                        </h6>
                        <div class="btn-group btn-group-sm" role="group">
                            <a asp-action="Details" asp-route-id="@row["MeetingVenueID"]"
                               class="btn btn-outline-primary" title="View Details">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-action="Schedule" asp-route-id="@row["MeetingVenueID"]"
                               class="btn btn-outline-info" title="View Schedule">
                                <i class="bi bi-calendar"></i>
                            </a>
                            <a asp-action="AddEdit" asp-route-id="@row["MeetingVenueID"]"
                               class="btn btn-outline-warning" title="Edit">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <button type="button" class="btn btn-outline-danger"
                                    onclick="confirmDelete(@row["MeetingVenueID"], '@row["MeetingVenueName"]')" title="Delete">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row text-center mb-3">
                            <div class="col-6">
                                <div class="p-2">
                                    <h5 class="text-primary mb-1 venue-total-meetings">-</h5>
                                    <small class="text-muted">Total Meetings</small>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-2">
                                    <h5 class="text-success mb-1 venue-upcoming-meetings">-</h5>
                                    <small class="text-muted">Upcoming</small>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <small class="text-muted">This Week</small>
                                <span class="badge bg-warning venue-week-meetings">Loading...</span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <small class="text-muted">Utilization Rate</small>
                            <div class="progress" style="height: 8px;">
                                <div class="progress-bar venue-utilization-bar" style="width: 0%"></div>
                            </div>
                            <small class="text-muted venue-utilization-text">Calculating...</small>
                        </div>

                        <div class="d-grid gap-1">
                            <a asp-action="Schedule" asp-route-id="@row["MeetingVenueID"]"
                               class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-calendar-week me-1"></i>View Schedule
                            </a>
                            <a href="/Meeting/Create?venueId=@row["MeetingVenueID"]"
                               class="btn btn-success btn-sm">
                                <i class="bi bi-plus-circle me-1"></i>Schedule Meeting
                            </a>
                        </div>
                    </div>
                    <div class="card-footer">
                        <small class="text-muted">
                            Created: @Convert.ToDateTime(row["Created"]).ToString("yyyy-MM-dd")
                        </small>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Bulk Actions (for table view) -->
    <div class="card mt-4">
        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center">
                <h6 class="mb-0">
                    <i class="bi bi-list me-2"></i>
                    Table View & Bulk Actions
                </h6>
                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="toggleTableView()">
                    <i class="bi bi-table me-1"></i>Show Table
                </button>
            </div>
        </div>
        <div class="card-body" id="tableView" style="display: none;">
            <form method="post" asp-action="BulkDelete" id="bulkDeleteForm">
                @Html.AntiForgeryToken()

                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th width="50">
                                    <input type="checkbox" id="selectAll" class="form-check-input" />
                                </th>
                                <th width="80">#</th>
                                <th>Venue Name</th>
                                <th width="120">Total Meetings</th>
                                <th width="120">Upcoming</th>
                                <th width="120">This Week</th>
                                <th width="150">Created Date</th>
                                <th width="120" class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (DataRow row in Model.Rows)
                            {
                                <tr>
                                    <td>
                                        <input type="checkbox" name="selectedIds" value="@row["MeetingVenueID"]"
                                               class="form-check-input row-checkbox" />
                                    </td>
                                    <td>@row["MeetingVenueID"]</td>
                                    <td>@row["MeetingVenueName"]</td>
                                    <td>
                                        <span class="badge bg-primary venue-table-total" data-venue-id="@row["MeetingVenueID"]">
                                            Loading...
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-success venue-table-upcoming" data-venue-id="@row["MeetingVenueID"]">
                                            Loading...
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-warning venue-table-week" data-venue-id="@row["MeetingVenueID"]">
                                            Loading...
                                        </span>
                                    </td>
                                    <td>
                                        <small class="text-muted">
                                            @Convert.ToDateTime(row["Created"]).ToString("yyyy-MM-dd")
                                        </small>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@row["MeetingVenueID"]"
                                               class="btn btn-sm btn-outline-primary" title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="AddEdit" asp-route-id="@row["MeetingVenueID"]"
                                               class="btn btn-sm btn-outline-warning" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <button type="button" class="btn btn-sm btn-outline-danger"
                                                    onclick="confirmDelete(@row["MeetingVenueID"], '@row["MeetingVenueName"]')" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Bulk Actions -->
                <div class="mt-3" id="bulkActions" style="display: none;">
                    <div class="row align-items-center">
                        <div class="col-md-6">
                            <span class="text-muted">
                                <span id="selectedCount">0</span> venue(s) selected
                            </span>
                        </div>
                        <div class="col-md-6 text-end">
                            <button type="button" class="btn btn-outline-secondary me-2" onclick="clearSelection()">
                                Clear Selection
                            </button>
                            <button type="submit" class="btn btn-danger"
                                    onclick="return confirmBulkDelete()">
                                <i class="bi bi-trash me-2"></i>Delete Selected
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
}
else
{
    <div class="text-center py-5">
        <i class="bi bi-geo-alt text-muted" style="font-size: 3rem;"></i>
        <h5 class="text-muted mt-3">No Meeting Venues Found</h5>
        <p class="text-muted">Get started by adding your first meeting venue.</p>
        <a asp-action="AddEdit" class="btn btn-primary">
            <i class="bi bi-plus-circle me-2"></i>Add First Venue
        </a>
    </div>
}

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete the venue: <strong id="deleteItemName"></strong>?</p>
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    <strong>Warning:</strong> This action cannot be undone. Make sure this venue is not being used by any scheduled meetings.
                </div>
                <div class="d-flex align-items-center">
                    <div class="spinner-border spinner-border-sm me-2" id="deleteCheckSpinner"></div>
                    <span id="deleteCheckMessage">Checking for dependencies...</span>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form method="post" asp-action="Delete" style="display: inline;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteItemId" />
                    <button type="submit" class="btn btn-danger" id="confirmDeleteBtn" disabled>
                        <i class="bi bi-trash me-2"></i>Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            loadVenueStatistics();
            setupBulkActions();
        });

        function loadVenueStatistics() {
            $('.venue-card').each(function() {
                var card = $(this);
                var venueId = card.data('venue-id');

                $.post('/MeetingVenue/GetVenueStatistics', { venueId: venueId }, function(response) {
                    if (!response.error) {
                        card.find('.venue-total-meetings').text(response.totalMeetings || 0);
                        card.find('.venue-upcoming-meetings').text(response.upcomingMeetings || 0);
                        card.find('.venue-week-meetings').text(response.thisWeekMeetings || 0);

                        var utilizationRate = response.utilizationRate || 0;
                        card.find('.venue-utilization-bar').css('width', utilizationRate + '%');
                        card.find('.venue-utilization-text').text(utilizationRate.toFixed(1) + '% utilization');

                        // Update table view as well
                        $('.venue-table-total[data-venue-id="' + venueId + '"]').text(response.totalMeetings || 0);
                        $('.venue-table-upcoming[data-venue-id="' + venueId + '"]').text(response.upcomingMeetings || 0);
                        $('.venue-table-week[data-venue-id="' + venueId + '"]').text(response.thisWeekMeetings || 0);
                    }
                });
            });
        }

        function toggleTableView() {
            $('#tableView').slideToggle();
        }

        function setupBulkActions() {
            $('#selectAll').change(function() {
                $('.row-checkbox').prop('checked', $(this).prop('checked'));
                updateBulkActions();
            });

            $('.row-checkbox').change(function() {
                updateBulkActions();
                updateSelectAll();
            });
        }

        function updateBulkActions() {
            var selectedCount = $('.row-checkbox:checked').length;
            $('#selectedCount').text(selectedCount);

            if (selectedCount > 0) {
                $('#bulkActions').show();
            } else {
                $('#bulkActions').hide();
            }
        }

        function updateSelectAll() {
            var totalCheckboxes = $('.row-checkbox').length;
            var checkedCheckboxes = $('.row-checkbox:checked').length;

            if (checkedCheckboxes === 0) {
                $('#selectAll').prop('indeterminate', false).prop('checked', false);
            } else if (checkedCheckboxes === totalCheckboxes) {
                $('#selectAll').prop('indeterminate', false).prop('checked', true);
            } else {
                $('#selectAll').prop('indeterminate', true);
            }
        }

        function clearSelection() {
            $('#selectAll').prop('checked', false);
            $('.row-checkbox').prop('checked', false);
            updateBulkActions();
        }

        function confirmDelete(id, name) {
            $('#deleteItemId').val(id);
            $('#deleteItemName').text(name);
            $('#confirmDeleteBtn').prop('disabled', true);
            $('#deleteCheckSpinner').show();
            $('#deleteCheckMessage').text('Checking for dependencies...');

            // Simulate dependency check
            setTimeout(function() {
                var hasDependencies = false;
                if (hasDependencies) {
                    $('#deleteCheckMessage').html(
                        '<span class="text-danger">Cannot delete: This venue has scheduled meetings.</span>'
                    );
                    $('#confirmDeleteBtn').prop('disabled', true);
                } else {
                    $('#deleteCheckMessage').html(
                        '<span class="text-success">No dependencies found. Safe to delete.</span>'
                    );
                    $('#confirmDeleteBtn').prop('disabled', false);
                }
                $('#deleteCheckSpinner').hide();
            }, 1000);

            var modal = new bootstrap.Modal(document.getElementById('deleteModal'));
            modal.show();
        }

        function confirmBulkDelete() {
            var selectedCount = $('.row-checkbox:checked').length;
            if (selectedCount === 0) {
                alert('Please select at least one item to delete.');
                return false;
            }

            return confirm('Are you sure you want to delete ' + selectedCount + ' selected venue(s)?\n\n' +
                          'Warning: This action cannot be undone. Make sure these venues have no scheduled meetings.');
        }

        function exportToExcel() {
            window.location.href = '@Url.Action("ExportToExcel")';
        }

        // Search functionality
        $('#searchText').on('keypress', function(e) {
            if (e.which === 13) {
                $(this).closest('form').submit();
            }
        });
    </script>
}
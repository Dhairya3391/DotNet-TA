@using System.Data
@model DataTable
@{
    ViewData["Title"] = "Meeting Venue Details";
    ViewData["PageTitle"] = "Meeting Venue Details";
    ViewData["PageDescription"] = "View detailed information about this meeting venue";

    var hasData = Model != null && Model.Rows.Count > 0;
    var venueId = 0;
    var venueName = string.Empty;
    DateTime created = DateTime.MinValue;
    DateTime modified = DateTime.MinValue;

    if (hasData)
    {
        DataRow row = Model!.Rows[0];
        venueId = Convert.ToInt32(row["MeetingVenueID"]);
        venueName = row["MeetingVenueName"].ToString();
        created = Convert.ToDateTime(row["Created"]);
        modified = Convert.ToDateTime(row["Modified"]);
    }
}

@if (!hasData)
{
    <div class="alert alert-warning">
        Unable to find details for this meeting venue.
    </div>
}
else
{
<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="bi bi-geo-alt me-2"></i>
                    Meeting Venue Information
                </h5>
                <div class="btn-group" role="group">
                    <a asp-action="AddEdit" asp-route-id="@venueId" class="btn btn-outline-warning btn-sm">
                        <i class="bi bi-pencil me-1"></i>Edit
                    </a>
                    <button type="button" class="btn btn-outline-danger btn-sm"
                            onclick="confirmDelete(@venueId, '@venueName')">
                        <i class="bi bi-trash me-1"></i>Delete
                    </button>
                </div>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="form-label text-muted">Venue ID</label>
                        <p class="form-control-plaintext fw-bold">@venueId</p>
                    </div>
                    <div class="col-md-8">
                        <label class="form-label text-muted">Venue Name</label>
                        <p class="form-control-plaintext">
                            <span class="badge bg-primary fs-6">@venueName</span>
                        </p>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <label class="form-label text-muted">Created Date</label>
                        <p class="form-control-plaintext">
                            <i class="bi bi-calendar-plus me-2"></i>
                            @created.ToString("yyyy-MM-dd HH:mm:ss")
                        </p>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted">Last Modified</label>
                        <p class="form-control-plaintext">
                            <i class="bi bi-calendar-check me-2"></i>
                            @modified.ToString("yyyy-MM-dd HH:mm:ss")
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0">
                    <i class="bi bi-bar-chart me-2"></i>
                    Usage Statistics
                </h6>
            </div>
            <div class="card-body">
                <div class="text-center mb-3">
                    <h2 class="text-primary mb-1" id="totalMeetingsCount">-</h2>
                    <small class="text-muted">Total Meetings</small>
                </div>

                <div class="row text-center">
                    <div class="col-6">
                        <div class="p-2">
                            <h5 class="text-success mb-1" id="upcomingMeetingsCount">-</h5>
                            <small class="text-muted">Upcoming</small>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-2">
                            <h5 class="text-info mb-1" id="utilizationRate">-%</h5>
                            <small class="text-muted">Utilization</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header">
                <h6 class="mb-0">
                    <i class="bi bi-calendar-week me-2"></i>
                    This Week's Schedule
                </h6>
            </div>
            <div class="card-body">
                <div id="weekSchedule">
                    <div class="text-center text-muted">
                        <div class="spinner-border spinner-border-sm me-2"></div>
                        Loading schedule...
                    </div>
                </div>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header">
                <h6 class="mb-0">
                    <i class="bi bi-lightning me-2"></i>
                    Quick Actions
                </h6>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a href="/Meeting?venueId=@venueId" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-calendar-event me-2"></i>
                        View All Meetings
                    </a>
                    <a asp-action="Schedule" asp-route-id="@venueId" class="btn btn-outline-info btn-sm">
                        <i class="bi bi-calendar3 me-2"></i>
                        View Full Schedule
                    </a>
                    <a href="/Meeting/Create?venueId=@venueId" class="btn btn-success btn-sm">
                        <i class="bi bi-plus-circle me-2"></i>
                        Schedule New Meeting
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-arrow-left me-2"></i>
                        Back to List
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete the venue: <strong id="deleteItemName"></strong>?</p>
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    <strong>Warning:</strong> This action cannot be undone. Make sure this venue is not being used by any existing or upcoming meetings.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form method="post" asp-action="Delete" style="display: inline;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteItemId" />
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-2"></i>Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

}

@section Scripts {
    <script>
        $(document).ready(function() {
            loadUsageStatistics();
            loadWeekSchedule();
        });

        function loadUsageStatistics() {
            $.post('/MeetingVenue/GetVenueStatistics', { venueId: @venueId }, function(data) {
                if (!data.error) {
                    $('#totalMeetingsCount').text(data.totalMeetings || 0);
                    $('#upcomingMeetingsCount').text(data.upcomingMeetings || 0);
                    $('#utilizationRate').text((data.utilizationRate || 0).toFixed(1) + '%');
                }
            }).fail(function() {
                $('#totalMeetingsCount').text('0');
                $('#upcomingMeetingsCount').text('0');
                $('#utilizationRate').text('0%');
            });
        }

        function loadWeekSchedule() {
            setTimeout(function() {
                var html = '<div class="list-group list-group-flush">';
                html += '<div class="list-group-item px-0 small">Mon - No meetings</div>';
                html += '<div class="list-group-item px-0 small">Tue - 2 meetings</div>';
                html += '<div class="list-group-item px-0 small">Wed - 1 meeting</div>';
                html += '<div class="list-group-item px-0 small">Thu - No meetings</div>';
                html += '<div class="list-group-item px-0 small">Fri - 3 meetings</div>';
                html += '</div>';
                $('#weekSchedule').html(html);
            }, 1000);
        }

        function confirmDelete(id, name) {
            $('#deleteItemId').val(id);
            $('#deleteItemName').text(name);
            var modal = new bootstrap.Modal(document.getElementById('deleteModal'));
            modal.show();
        }
    </script>
}

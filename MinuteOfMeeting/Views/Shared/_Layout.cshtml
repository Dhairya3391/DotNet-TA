<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Minutes of Meeting Management System</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="page-wrapper">
        <!-- Header -->
        <header class="main-header navbar navbar-expand-lg navbar-dark">
            <div class="container">
                <a class="navbar-brand" href="/">
                    <i class="bi bi-calendar-check"></i>
                    Minutes of Meeting
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        @if (MinuteOfMeeting.Helpers.SessionHelper.IsUserLoggedIn(Context))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")" href="@Url.Action("Index", "Dashboard")">
                                    <i class="bi bi-speedometer2"></i> Dashboard
                                </a>
                            </li>

                            @if (MinuteOfMeeting.Helpers.SessionHelper.CanManageMeetings(Context))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="masterDataDropdown" role="button" data-bs-toggle="dropdown">
                                        <i class="bi bi-database"></i> Master Data
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" href="@Url.Action("Index", "MeetingType")">
                                            <i class="bi bi-tags"></i> Meeting Types
                                        </a></li>
                                        <li><a class="dropdown-item" href="@Url.Action("Index", "Department")">
                                            <i class="bi bi-building"></i> Departments
                                        </a></li>
                                        <li><a class="dropdown-item" href="@Url.Action("Index", "MeetingVenue")">
                                            <i class="bi bi-geo-alt"></i> Venues
                                        </a></li>
                                        <li><a class="dropdown-item" href="@Url.Action("Index", "Staff")">
                                            <i class="bi bi-people"></i> Staff Members
                                        </a></li>
                                    </ul>
                                </li>

                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="meetingsDropdown" role="button" data-bs-toggle="dropdown">
                                        <i class="bi bi-calendar-event"></i> Meetings
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" href="@Url.Action("Index", "Meeting")">
                                            <i class="bi bi-list-ul"></i> All Meetings
                                        </a></li>
                                        <li><a class="dropdown-item" href="@Url.Action("Create", "Meeting")">
                                            <i class="bi bi-plus-circle"></i> Schedule Meeting
                                        </a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><span class="dropdown-item text-muted">
                                            <i class="bi bi-info-circle me-2"></i>Attendance via Meeting Details
                                        </span></li>
                                    </ul>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Meeting" ? "active" : "")" href="@Url.Action("Index", "Meeting")">
                                        <i class="bi bi-calendar-event"></i> My Meetings
                                    </a>
                                </li>
                            }
                        }
                    </ul>

                    <ul class="navbar-nav">
                        @if (MinuteOfMeeting.Helpers.SessionHelper.IsUserLoggedIn(Context))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle"></i>
                                    @MinuteOfMeeting.Helpers.SessionHelper.GetUsername(Context)
                                    <span class="badge bg-warning text-dark">@MinuteOfMeeting.Helpers.SessionHelper.GetUserRole(Context)</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><h6 class="dropdown-header">Welcome, @MinuteOfMeeting.Helpers.SessionHelper.GetStaffName(Context)</h6></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="@Url.Action("Profile", "Account")">
                                        <i class="bi bi-person"></i> Profile
                                    </a></li>
                                    <li><a class="dropdown-item" href="@Url.Action("ChangePassword", "Account")">
                                        <i class="bi bi-key"></i> Change Password
                                    </a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="@Url.Action("Logout", "Account")">
                                        <i class="bi bi-box-arrow-right"></i> Logout
                                    </a></li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Login", "Account")">
                                    <i class="bi bi-box-arrow-in-right"></i> Login
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Register", "Account")">
                                    <i class="bi bi-person-plus"></i> Register
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </header>

        <!-- Main Content -->
        <main class="content-wrapper">
            <div class="container">
                <!-- Flash Messages -->
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i>
                        @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @if (TempData["Warning"] != null)
                {
                    <div class="alert alert-warning alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        @TempData["Warning"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @if (TempData["Info"] != null)
                {
                    <div class="alert alert-info alert-dismissible fade show" role="alert">
                        <i class="bi bi-info-circle-fill me-2"></i>
                        @TempData["Info"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <!-- Page Header -->
                @if (!string.IsNullOrEmpty(ViewData["PageTitle"] as string))
                {
                    <div class="row mb-4">
                        <div class="col-12">
                            <h1 class="h3 mb-0">
                                <span class="text-gradient">@ViewData["PageTitle"]</span>
                            </h1>
                            @if (!string.IsNullOrEmpty(ViewData["PageDescription"] as string))
                            {
                                <p class="text-muted">@ViewData["PageDescription"]</p>
                            }
                        </div>
                    </div>
                }

                <!-- Render Body -->
                @RenderBody()
            </div>
        </main>

        <!-- Footer -->
        <footer class="main-footer">
            <div class="container">
                <div class="row">
                    <div class="col-md-6">
                        <h5 class="text-white">Minutes of Meeting System</h5>
                        <p class="text-white-50">
                            A comprehensive meeting management solution for organizations.
                            Built with ASP.NET Core MVC and SQL Server.
                        </p>
                    </div>
                    <div class="col-md-6 text-md-end">
                        <p class="text-white-50 mb-0">
                            © @DateTime.Now.Year - Darshan University<br>
                            Course: 2301CS412 - ASP.NET Core<br>
                            TA Reference Implementation
                        </p>
                    </div>
                </div>
            </div>
        </footer>
    </div>

    <!-- Scripts - jQuery first, then Bootstrap -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Chart.js - Loaded only when needed for dashboard -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js" defer></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Minutes of Meeting Management System</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />

    <!-- Bulma CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bulma@0.9.4/css/bulma.min.css" />

    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <!-- Custom Bulma Overrides -->
    <link rel="stylesheet" href="~/css/site.bulma.css" asp-append-version="true" />
</head>
<body>
    <div id="app" class="min-h-screen">
        <!-- Bulma Navbar -->
        <nav class="navbar is-primary" role="navigation" aria-label="main navigation">
            <div class="container">
                <div class="navbar-brand">
                    <a class="navbar-item has-text-weight-bold" href="/">
                        <span class="icon is-medium">
                            <i class="fas fa-calendar-check"></i>
                        </span>
                        <span class="ml-2">Minutes of Meeting</span>
                    </a>

                    <!-- Mobile menu burger -->
                    <a role="button" class="navbar-burger" aria-label="menu" aria-expanded="false" data-target="navbarMenu">
                        <span aria-hidden="true"></span>
                        <span aria-hidden="true"></span>
                        <span aria-hidden="true"></span>
                    </a>
                </div>

                <div id="navbarMenu" class="navbar-menu">
                    <div class="navbar-start">
                        @if (MinuteOfMeeting.Helpers.SessionHelper.IsUserLoggedIn(Context))
                        {
                            <a class="navbar-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "is-active" : "")"
                               href="@Url.Action("Index", "Dashboard")">
                                <span class="icon">
                                    <i class="fas fa-tachometer-alt"></i>
                                </span>
                                <span>Dashboard</span>
                            </a>

                            @if (MinuteOfMeeting.Helpers.SessionHelper.CanManageMeetings(Context))
                            {
                                <!-- Master Data Dropdown -->
                                <div class="navbar-item has-dropdown is-hoverable">
                                    <a class="navbar-link">
                                        <span class="icon">
                                            <i class="fas fa-database"></i>
                                        </span>
                                        <span>Master Data</span>
                                    </a>
                                    <div class="navbar-dropdown">
                                        <a class="navbar-item" href="@Url.Action("Index", "MeetingType")">
                                            <span class="icon">
                                                <i class="fas fa-tags"></i>
                                            </span>
                                            <span>Meeting Types</span>
                                        </a>
                                        <a class="navbar-item" href="@Url.Action("Index", "Department")">
                                            <span class="icon">
                                                <i class="fas fa-building"></i>
                                            </span>
                                            <span>Departments</span>
                                        </a>
                                        <a class="navbar-item" href="@Url.Action("Index", "MeetingVenue")">
                                            <span class="icon">
                                                <i class="fas fa-map-marker-alt"></i>
                                            </span>
                                            <span>Venues</span>
                                        </a>
                                        <a class="navbar-item" href="@Url.Action("Index", "Staff")">
                                            <span class="icon">
                                                <i class="fas fa-users"></i>
                                            </span>
                                            <span>Staff Members</span>
                                        </a>
                                    </div>
                                </div>

                                <!-- Meetings Dropdown -->
                                <div class="navbar-item has-dropdown is-hoverable">
                                    <a class="navbar-link">
                                        <span class="icon">
                                            <i class="fas fa-calendar-alt"></i>
                                        </span>
                                        <span>Meetings</span>
                                    </a>
                                    <div class="navbar-dropdown">
                                        <a class="navbar-item" href="@Url.Action("Index", "Meeting")">
                                            <span class="icon">
                                                <i class="fas fa-list"></i>
                                            </span>
                                            <span>All Meetings</span>
                                        </a>
                                        <a class="navbar-item" href="@Url.Action("Create", "Meeting")">
                                            <span class="icon">
                                                <i class="fas fa-plus-circle"></i>
                                            </span>
                                            <span>Schedule Meeting</span>
                                        </a>
                                        <hr class="navbar-divider">
                                        <a class="navbar-item" href="@Url.Action("Index", "MeetingMember")">
                                            <span class="icon">
                                                <i class="fas fa-check-square"></i>
                                            </span>
                                            <span>Attendance Management</span>
                                        </a>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <a class="navbar-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Meeting" ? "is-active" : "")"
                                   href="@Url.Action("Index", "Meeting")">
                                    <span class="icon">
                                        <i class="fas fa-calendar-alt"></i>
                                    </span>
                                    <span>My Meetings</span>
                                </a>
                            }
                        }
                    </div>

                    <div class="navbar-end">
                        @if (MinuteOfMeeting.Helpers.SessionHelper.IsUserLoggedIn(Context))
                        {
                            <div class="navbar-item has-dropdown is-hoverable">
                                <a class="navbar-link">
                                    <span class="icon">
                                        <i class="fas fa-user-circle"></i>
                                    </span>
                                    <span class="ml-1">@MinuteOfMeeting.Helpers.SessionHelper.GetUsername(Context)</span>
                                    <span class="tag is-warning is-light ml-2">@MinuteOfMeeting.Helpers.SessionHelper.GetUserRole(Context)</span>
                                </a>
                                <div class="navbar-dropdown is-right">
                                    <div class="navbar-item has-text-weight-bold">
                                        Welcome, @MinuteOfMeeting.Helpers.SessionHelper.GetStaffName(Context)
                                    </div>
                                    <hr class="navbar-divider">
                                    <a class="navbar-item" href="@Url.Action("Profile", "Account")">
                                        <span class="icon">
                                            <i class="fas fa-user"></i>
                                        </span>
                                        <span>Profile</span>
                                    </a>
                                    <a class="navbar-item" href="@Url.Action("ChangePassword", "Account")">
                                        <span class="icon">
                                            <i class="fas fa-key"></i>
                                        </span>
                                        <span>Change Password</span>
                                    </a>
                                    <hr class="navbar-divider">
                                    <a class="navbar-item has-text-danger" href="@Url.Action("Logout", "Account")">
                                        <span class="icon">
                                            <i class="fas fa-sign-out-alt"></i>
                                        </span>
                                        <span>Logout</span>
                                    </a>
                                </div>
                            </div>
                        }
                        else
                        {
                            <a class="navbar-item" href="@Url.Action("Login", "Account")">
                                <span class="icon">
                                    <i class="fas fa-sign-in-alt"></i>
                                </span>
                                <span>Login</span>
                            </a>
                            <a class="navbar-item" href="@Url.Action("Register", "Account")">
                                <span class="icon">
                                    <i class="fas fa-user-plus"></i>
                                </span>
                                <span>Register</span>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>

        <!-- Flash Messages Section -->
        @if (TempData["Success"] != null || TempData["Error"] != null || TempData["Warning"] != null || TempData["Info"] != null)
        {
            <section class="section is-small">
                <div class="container">
                    @if (TempData["Success"] != null)
                    {
                        <div class="notification is-success is-light">
                            <button class="delete"></button>
                            <span class="icon">
                                <i class="fas fa-check-circle"></i>
                            </span>
                            <span>@TempData["Success"]</span>
                        </div>
                    }

                    @if (TempData["Error"] != null)
                    {
                        <div class="notification is-danger is-light">
                            <button class="delete"></button>
                            <span class="icon">
                                <i class="fas fa-exclamation-triangle"></i>
                            </span>
                            <span>@TempData["Error"]</span>
                        </div>
                    }

                    @if (TempData["Warning"] != null)
                    {
                        <div class="notification is-warning is-light">
                            <button class="delete"></button>
                            <span class="icon">
                                <i class="fas fa-exclamation-triangle"></i>
                            </span>
                            <span>@TempData["Warning"]</span>
                        </div>
                    }

                    @if (TempData["Info"] != null)
                    {
                        <div class="notification is-info is-light">
                            <button class="delete"></button>
                            <span class="icon">
                                <i class="fas fa-info-circle"></i>
                            </span>
                            <span>@TempData["Info"]</span>
                        </div>
                    }
                </div>
            </section>
        }

        <!-- Page Header -->
        @if (!string.IsNullOrEmpty(ViewData["PageTitle"] as string))
        {
            <section class="hero is-light is-small">
                <div class="hero-body">
                    <div class="container">
                        <h1 class="title is-3">
                            @ViewData["PageTitle"]
                        </h1>
                        @if (!string.IsNullOrEmpty(ViewData["PageDescription"] as string))
                        {
                            <p class="subtitle is-6 has-text-grey">@ViewData["PageDescription"]</p>
                        }
                    </div>
                </div>
            </section>
        }

        <!-- Main Content -->
        <main class="section">
            <div class="container">
                @RenderBody()
            </div>
        </main>

        <!-- Footer -->
        <footer class="footer">
            <div class="container">
                <div class="columns">
                    <div class="column is-6">
                        <h5 class="title is-6 has-text-weight-bold">Minutes of Meeting System</h5>
                        <p class="has-text-grey">
                            A comprehensive meeting management solution for organizations.
                            Built with ASP.NET Core MVC and SQL Server.
                        </p>
                    </div>
                    <div class="column is-6 has-text-right">
                        <p class="has-text-grey is-size-7">
                            © @DateTime.Now.Year - Darshan University<br>
                            Course: 2301CS412 - ASP.NET Core<br>
                            TA Reference Implementation
                        </p>
                    </div>
                </div>
            </div>
        </footer>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- Chart.js for dashboard charts -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js" defer></script>

    <!-- Custom UI JavaScript -->
    <script src="~/js/ui.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

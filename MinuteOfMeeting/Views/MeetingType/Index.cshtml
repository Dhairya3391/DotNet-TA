@using System.Data
@model DataTable
@{
    ViewData["Title"] = "Meeting Types";
    ViewData["PageTitle"] = "Meeting Types";
    ViewData["PageDescription"] = "Manage different types of meetings in the organization";
}

<!-- Page Actions -->
<div class="level mb-4">
    <div class="level-left">
        <div>
            <h4 class="title is-4">Meeting Types Management</h4>
            <p class="subtitle is-6 has-text-grey">Configure and organize meeting categories</p>
        </div>
    </div>
    <div class="level-right">
        <div class="buttons">
            <a asp-action="AddEdit" class="button is-primary">
                <span class="icon">
                    <i class="fas fa-plus"></i>
                </span>
                <span>Add New Type</span>
            </a>
            <button type="button" class="button is-success" onclick="exportToExcel()">
                <span class="icon">
                    <i class="fas fa-file-excel"></i>
                </span>
                <span>Export</span>
            </button>
        </div>
    </div>
</div>

<!-- Search and Filter Bar -->
<div class="card mb-4">
    <div class="card-content">
        <form method="get">
            <div class="field has-addons">
                <div class="control is-expanded">
                    <input type="text" name="searchText" class="input"
                           placeholder="Search meeting types..." value="@ViewData["SearchText"]" />
                </div>
                <div class="control">
                    <button type="submit" class="button is-info">
                        <span class="icon">
                            <i class="fas fa-search"></i>
                        </span>
                        <span>Search</span>
                    </button>
                </div>
                <div class="control">
                    <a asp-action="Index" class="button is-light">
                        <span class="icon">
                            <i class="fas fa-times"></i>
                        </span>
                        <span>Clear</span>
                    </a>
                </div>
            </div>
            <div class="field">
                <p class="has-text-grey">
                    Total Records: <strong>@(Model?.Rows.Count ?? 0)</strong>
                </p>
            </div>
        </form>
    </div>
</div>

<!-- Meeting Types Table -->
<div class="card">
    <header class="card-header">
        <p class="card-header-title">
            <span class="icon">
                <i class="fas fa-tags"></i>
            </span>
            Meeting Types List
        </p>
    </header>
    <div class="card-content">
        @if (Model != null && Model.Rows.Count > 0)
        {
            <form method="post" asp-action="BulkDelete" id="bulkDeleteForm">
                @Html.AntiForgeryToken()

                <div class="table-container">
                    <table class="table is-fullwidth is-hoverable is-striped" id="meetingTypesTable">
                        <thead>
                            <tr>
                                <th style="width: 50px;">
                                    <input type="checkbox" id="selectAll" />
                                </th>
                                <th style="width: 80px;">#</th>
                                <th>Meeting Type Name</th>
                                <th>Remarks</th>
                                <th style="width: 150px;">Created Date</th>
                                <th style="width: 150px;">Modified Date</th>
                                <th style="width: 120px;" class="has-text-centered">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (DataRow row in Model.Rows)
                            {
                                <tr>
                                    <td>
                                        <input type="checkbox" name="selectedIds" value="@row["MeetingTypeID"]"
                                               class="row-checkbox" />
                                    </td>
                                    <td>@row["MeetingTypeID"]</td>
                                    <td>
                                        <strong>@row["MeetingTypeName"]</strong>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(row["Remarks"].ToString()))
                                        {
                                            <span>@row["Remarks"]</span>
                                        }
                                        else
                                        {
                                            <span class="has-text-grey">No remarks</span>
                                        }
                                    </td>
                                    <td>
                                        <small class="has-text-grey">
                                            @Convert.ToDateTime(row["Created"]).ToString("yyyy-MM-dd")
                                        </small>
                                    </td>
                                    <td>
                                        <small class="has-text-grey">
                                            @Convert.ToDateTime(row["Modified"]).ToString("yyyy-MM-dd HH:mm")
                                        </small>
                                    </td>
                                    <td class="has-text-centered">
                                        <div class="buttons are-small is-justify-content-center">
                                            <a asp-action="Details" asp-route-id="@row["MeetingTypeID"]"
                                               class="button is-info is-outlined" title="View Details">
                                                <span class="icon">
                                                    <i class="fas fa-eye"></i>
                                                </span>
                                            </a>
                                            <a asp-action="AddEdit" asp-route-id="@row["MeetingTypeID"]"
                                               class="button is-warning is-outlined" title="Edit">
                                                <span class="icon">
                                                    <i class="fas fa-edit"></i>
                                                </span>
                                            </a>
                                            <button type="button" class="button is-danger is-outlined js-modal-trigger"
                                                    data-target="delete-modal" data-id="@row["MeetingTypeID"]"
                                                    data-name="@row["MeetingTypeName"]" title="Delete">
                                                <span class="icon">
                                                    <i class="fas fa-trash"></i>
                                                </span>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Bulk Actions -->
                <div class="field mt-4" id="bulkActions" style="display: none;">
                    <div class="level">
                        <div class="level-left">
                            <div class="level-item">
                                <span class="tag is-info">
                                    <span id="selectedCount">0</span> item(s) selected
                                </span>
                            </div>
                        </div>
                        <div class="level-right">
                            <div class="level-item">
                                <button type="button" class="button is-light" onclick="clearSelection()">
                                    <span class="icon">
                                        <i class="fas fa-times"></i>
                                    </span>
                                    <span>Clear Selection</span>
                                </button>
                            </div>
                            <div class="level-item">
                                <button type="submit" class="button is-danger"
                                        onclick="return confirmBulkDelete()">
                                    <span class="icon">
                                        <i class="fas fa-trash"></i>
                                    </span>
                                    <span>Delete Selected</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        }
        else
        {
            <div class="has-text-centered py-6">
                <span class="icon has-text-grey" style="font-size: 3rem;">
                    <i class="fas fa-tags"></i>
                </span>
                <h5 class="title is-5 has-text-grey mt-3">No Meeting Types Found</h5>
                <p class="has-text-grey">Get started by adding your first meeting type.</p>
                <a asp-action="AddEdit" class="button is-primary mt-3">
                    <span class="icon">
                        <i class="fas fa-plus"></i>
                    </span>
                    <span>Add First Meeting Type</span>
                </a>
            </div>
        }
    </div>
</div>


@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Select all checkbox functionality
            const selectAllCheckbox = document.getElementById('selectAll');
            const rowCheckboxes = document.querySelectorAll('.row-checkbox');

            selectAllCheckbox.addEventListener('change', function() {
                rowCheckboxes.forEach(checkbox => {
                    checkbox.checked = selectAllCheckbox.checked;
                });
                updateBulkActions();
                updateSelectAll();
            });

            // Individual checkbox functionality
            rowCheckboxes.forEach(checkbox => {
                checkbox.addEventListener('change', function() {
                    updateBulkActions();
                    updateSelectAll();
                });
            });

            // Initialize bulk actions visibility
            updateBulkActions();

            // Modal trigger setup
            const modalTriggers = document.querySelectorAll('.js-modal-trigger');
            modalTriggers.forEach(trigger => {
                trigger.addEventListener('click', function() {
                    const id = this.dataset.id;
                    const name = this.dataset.name;
                    setupDeleteModal(id, name);
                });
            });
        });

        function updateBulkActions() {
            const selectedCount = document.querySelectorAll('.row-checkbox:checked').length;
            const selectedCountSpan = document.getElementById('selectedCount');
            const bulkActions = document.getElementById('bulkActions');

            selectedCountSpan.textContent = selectedCount;

            if (selectedCount > 0) {
                bulkActions.style.display = 'block';
            } else {
                bulkActions.style.display = 'none';
            }
        }

        function updateSelectAll() {
            const totalCheckboxes = document.querySelectorAll('.row-checkbox').length;
            const checkedCheckboxes = document.querySelectorAll('.row-checkbox:checked').length;
            const selectAllCheckbox = document.getElementById('selectAll');

            if (checkedCheckboxes === 0) {
                selectAllCheckbox.indeterminate = false;
                selectAllCheckbox.checked = false;
            } else if (checkedCheckboxes === totalCheckboxes) {
                selectAllCheckbox.indeterminate = false;
                selectAllCheckbox.checked = true;
            } else {
                selectAllCheckbox.indeterminate = true;
                selectAllCheckbox.checked = false;
            }
        }

        function clearSelection() {
            const selectAllCheckbox = document.getElementById('selectAll');
            const rowCheckboxes = document.querySelectorAll('.row-checkbox');

            selectAllCheckbox.checked = false;
            selectAllCheckbox.indeterminate = false;
            rowCheckboxes.forEach(checkbox => {
                checkbox.checked = false;
            });
            updateBulkActions();
        }

        function setupDeleteModal(id, name) {
            const deleteIdInput = document.getElementById('delete-id');
            const deleteForm = document.getElementById('delete-form');

            deleteIdInput.value = id;

            // Set the form action based on the current controller
            const currentPath = window.location.pathname;
            const controller = currentPath.split('/')[1] || 'MeetingType';
            deleteForm.action = `/${controller}/Delete/${id}`;
        }

        function confirmBulkDelete() {
            const selectedCount = document.querySelectorAll('.row-checkbox:checked').length;
            if (selectedCount === 0) {
                window.UIManager.showNotification('Please select at least one item to delete.', 'warning');
                return false;
            }

            const confirmed = confirm(`Are you sure you want to delete ${selectedCount} selected meeting type(s)?\n\n` +
                          'Warning: This action cannot be undone. Make sure these meeting types are not being used by any meetings.');

            if (confirmed) {
                window.UIManager.showLoading();
                return true;
            }
            return false;
        }

        function exportToExcel() {
            window.location.href = '@Url.Action("ExportToExcel")';
        }

        // Search functionality
        const searchInput = document.querySelector('input[name="searchText"]');
        if (searchInput) {
            searchInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    this.closest('form').submit();
                }
            });
        }
    </script>
}
@using System.Data
@model DataTable
@{
    ViewData["Title"] = "Meeting Type Details";
    ViewData["PageTitle"] = "Meeting Type Details";
    ViewData["PageDescription"] = "View detailed information about this meeting type";

    var hasData = Model != null && Model.Rows.Count > 0;
    var meetingTypeId = 0;
    var meetingTypeName = string.Empty;
    var remarks = string.Empty;
    DateTime created = DateTime.MinValue;
    DateTime modified = DateTime.MinValue;

    if (hasData)
    {
        DataRow row = Model!.Rows[0];
        meetingTypeId = Convert.ToInt32(row["MeetingTypeID"]);
        meetingTypeName = row["MeetingTypeName"].ToString();
        remarks = row["Remarks"].ToString();
        created = Convert.ToDateTime(row["Created"]);
        modified = Convert.ToDateTime(row["Modified"]);
    }
}

@if (!hasData)
{
    <div class="alert alert-warning">
        Unable to find details for this meeting type.
    </div>
}
else
{
<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="bi bi-tag me-2"></i>
                    Meeting Type Information
                </h5>
                <div class="btn-group" role="group">
                    <a asp-action="AddEdit" asp-route-id="@meetingTypeId" class="btn btn-outline-warning btn-sm">
                        <i class="bi bi-pencil me-1"></i>Edit
                    </a>
                    <button type="button" class="btn btn-outline-danger btn-sm"
                            onclick="confirmDelete(@meetingTypeId, '@meetingTypeName')">
                        <i class="bi bi-trash me-1"></i>Delete
                    </button>
                </div>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="form-label text-muted">Meeting Type ID</label>
                        <p class="form-control-plaintext fw-bold">@meetingTypeId</p>
                    </div>
                    <div class="col-md-8">
                        <label class="form-label text-muted">Meeting Type Name</label>
                        <p class="form-control-plaintext">
                            <span class="badge bg-primary fs-6">@meetingTypeName</span>
                        </p>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted">Remarks</label>
                    <p class="form-control-plaintext">
                        @if (!string.IsNullOrEmpty(remarks))
                        {
                            @remarks
                        }
                        else
                        {
                            <span class="text-muted">No remarks provided</span>
                        }
                    </p>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <label class="form-label text-muted">Created Date</label>
                        <p class="form-control-plaintext">
                            <i class="bi bi-calendar-plus me-2"></i>
                            @created.ToString("yyyy-MM-dd HH:mm:ss")
                        </p>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted">Last Modified</label>
                        <p class="form-control-plaintext">
                            <i class="bi bi-calendar-check me-2"></i>
                            @modified.ToString("yyyy-MM-dd HH:mm:ss")
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0">
                    <i class="bi bi-bar-chart me-2"></i>
                    Usage Statistics
                </h6>
            </div>
            <div class="card-body">
                <div class="text-center mb-3">
                    <h2 class="text-primary mb-1" id="totalMeetingsCount">-</h2>
                    <small class="text-muted">Total Meetings</small>
                </div>

                <div class="row text-center">
                    <div class="col-6">
                        <div class="p-2">
                            <h5 class="text-success mb-1" id="upcomingMeetingsCount">-</h5>
                            <small class="text-muted">Upcoming</small>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-2">
                            <h5 class="text-info mb-1" id="completedMeetingsCount">-</h5>
                            <small class="text-muted">Completed</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header">
                <h6 class="mb-0">
                    <i class="bi bi-clock-history me-2"></i>
                    Recent Activity
                </h6>
            </div>
            <div class="card-body">
                <div id="recentMeetingsList">
                    <div class="text-center text-muted">
                        <div class="spinner-border spinner-border-sm me-2"></div>
                        Loading recent meetings...
                    </div>
                </div>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header">
                <h6 class="mb-0">
                    <i class="bi bi-lightning me-2"></i>
                    Quick Actions
                </h6>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a href="/Meeting?meetingTypeId=@meetingTypeId" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-calendar-event me-2"></i>
                        View All Meetings
                    </a>
                    <a href="/Meeting/Create?meetingTypeId=@meetingTypeId" class="btn btn-success btn-sm">
                        <i class="bi bi-plus-circle me-2"></i>
                        Schedule New Meeting
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-arrow-left me-2"></i>
                        Back to List
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete the meeting type: <strong id="deleteItemName"></strong>?</p>
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    <strong>Warning:</strong> This action cannot be undone. Make sure this meeting type is not being used by any existing meetings.
                </div>
                <div class="d-flex align-items-center">
                    <div class="spinner-border spinner-border-sm me-2" id="deleteCheckSpinner"></div>
                    <span id="deleteCheckMessage">Checking for dependencies...</span>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form method="post" asp-action="Delete" style="display: inline;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteItemId" />
                    <button type="submit" class="btn btn-danger" id="confirmDeleteBtn" disabled>
                        <i class="bi bi-trash me-2"></i>Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

}

@section Scripts {
    <script>
        $(document).ready(function() {
            loadUsageStatistics();
            loadRecentMeetings();
        });

        function loadUsageStatistics() {
            // Simulate loading statistics (in real app, this would be an API call)
            setTimeout(function() {
                $('#totalMeetingsCount').text('12');
                $('#upcomingMeetingsCount').text('3');
                $('#completedMeetingsCount').text('9');
            }, 1000);
        }

        function loadRecentMeetings() {
            // Simulate loading recent meetings (in real app, this would be an API call)
            setTimeout(function() {
                var recentMeetings = [
                    { date: '2025-01-20', title: 'Q1 Planning Session' },
                    { date: '2025-01-18', title: 'Team Review Meeting' },
                    { date: '2025-01-15', title: 'Budget Discussion' }
                ];

                var html = '';
                if (recentMeetings.length > 0) {
                    html = '<div class="list-group list-group-flush">';
                    recentMeetings.forEach(function(meeting) {
                        html += `
                            <div class="list-group-item px-0">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <small class="text-muted">${meeting.date}</small><br>
                                        <small>${meeting.title}</small>
                                    </div>
                                    <i class="bi bi-chevron-right text-muted"></i>
                                </div>
                            </div>
                        `;
                    });
                    html += '</div>';
                } else {
                    html = '<p class="text-muted small mb-0">No recent meetings found.</p>';
                }

                $('#recentMeetingsList').html(html);
            }, 1500);
        }

        function confirmDelete(id, name) {
            $('#deleteItemId').val(id);
            $('#deleteItemName').text(name);
            $('#confirmDeleteBtn').prop('disabled', true);
            $('#deleteCheckSpinner').show();
            $('#deleteCheckMessage').text('Checking for dependencies...');

            // Simulate dependency check (in real app, this would be an API call)
            setTimeout(function() {
                var hasDependencies = false; // Simulate no dependencies
                if (hasDependencies) {
                    $('#deleteCheckMessage').html(
                        '<span class="text-danger">Cannot delete: This meeting type is being used by existing meetings.</span>'
                    );
                    $('#confirmDeleteBtn').prop('disabled', true);
                } else {
                    $('#deleteCheckMessage').html(
                        '<span class="text-success">No dependencies found. Safe to delete.</span>'
                    );
                    $('#confirmDeleteBtn').prop('disabled', false);
                }
                $('#deleteCheckSpinner').hide();
            }, 1000);

            var modal = new bootstrap.Modal(document.getElementById('deleteModal'));
            modal.show();
        }
    </script>
}
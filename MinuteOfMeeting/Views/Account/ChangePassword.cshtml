@model MinuteOfMeeting.Controllers.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
    ViewData["PageTitle"] = "Change Password";
    ViewData["PageDescription"] = "Update your account password";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="bi bi-key me-2"></i>
                    Change Password
                </h5>
            </div>
            <div class="card-body">
                <form asp-action="ChangePassword" method="post">
                    @Html.AntiForgeryToken()

                    <div class="alert alert-info mb-4">
                        <i class="bi bi-info-circle me-2"></i>
                        For your security, please choose a strong password that includes:
                        <ul class="mb-0 mt-2">
                            <li>At least 6 characters</li>
                            <li>Mixture of letters and numbers</li>
                            <li>Preferably include special characters</li>
                        </ul>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="CurrentPassword" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-key"></i>
                            </span>
                            <input asp-for="CurrentPassword" class="form-control" type="password" placeholder="Enter current password" autocomplete="current-password" />
                            <button class="btn btn-outline-secondary" type="button" id="toggleCurrentPassword">
                                <i class="bi bi-eye" id="currentPasswordIcon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="NewPassword" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-shield-lock"></i>
                            </span>
                            <input asp-for="NewPassword" class="form-control" type="password" placeholder="Enter new password" autocomplete="new-password" id="newPasswordInput" />
                            <button class="btn btn-outline-secondary" type="button" id="toggleNewPassword">
                                <i class="bi bi-eye" id="newPasswordIcon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                        <div class="progress mt-2" style="height: 5px;">
                            <div class="progress-bar" id="passwordStrength" role="progressbar" style="width: 0%"></div>
                        </div>
                        <small class="text-muted" id="passwordStrengthText">Password strength: Not entered</small>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="ConfirmNewPassword" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-shield-check"></i>
                            </span>
                            <input asp-for="ConfirmNewPassword" class="form-control" type="password" placeholder="Confirm new password" autocomplete="new-password" />
                            <button class="btn btn-outline-secondary" type="button" id="toggleConfirmPassword">
                                <i class="bi bi-eye" id="confirmPasswordIcon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-key me-2"></i>
                            Update Password
                        </button>
                        <a asp-action="Profile" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-2"></i>
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        $(document).ready(function() {
            // Toggle password visibility
            function togglePassword(inputId, iconId) {
                var passwordField = $('#' + inputId);
                var passwordIcon = $('#' + iconId);

                if (passwordField.attr('type') === 'password') {
                    passwordField.attr('type', 'text');
                    passwordIcon.removeClass('bi-eye').addClass('bi-eye-slash');
                } else {
                    passwordField.attr('type', 'password');
                    passwordIcon.removeClass('bi-eye-slash').addClass('bi-eye');
                }
            }

            $('#toggleCurrentPassword').click(function() {
                togglePassword('CurrentPassword', 'currentPasswordIcon');
            });

            $('#toggleNewPassword').click(function() {
                togglePassword('NewPassword', 'newPasswordIcon');
            });

            $('#toggleConfirmPassword').click(function() {
                togglePassword('ConfirmNewPassword', 'confirmPasswordIcon');
            });

            // Password strength checker
            function checkPasswordStrength(password) {
                var strength = 0;
                var strengthText = 'Weak';
                var strengthColor = 'bg-danger';

                if (password.length >= 6) strength += 25;
                if (password.length >= 8) strength += 10;
                if (/[a-z]/.test(password) && /[A-Z]/.test(password)) strength += 15;
                if (/[0-9]/.test(password)) strength += 20;
                if (/[^a-zA-Z0-9]/.test(password)) strength += 30;

                if (strength >= 70) {
                    strengthText = 'Strong';
                    strengthColor = 'bg-success';
                } else if (strength >= 40) {
                    strengthText = 'Medium';
                    strengthColor = 'bg-warning';
                } else if (strength > 0) {
                    strengthText = 'Weak';
                    strengthColor = 'bg-danger';
                } else {
                    strengthText = 'Not entered';
                    strengthColor = 'bg-secondary';
                }

                return {
                    strength: strength,
                    text: strengthText,
                    color: strengthColor
                };
            }

            $('#NewPassword').on('input', function() {
                var password = $(this).val();
                var result = checkPasswordStrength(password);

                var progressBar = $('#passwordStrength');
                progressBar.css('width', result.strength + '%')
                    .removeClass('bg-danger bg-warning bg-success bg-secondary')
                    .addClass(result.color);

                $('#passwordStrengthText').text('Password strength: ' + result.text);
            });

            // Focus on current password field
            $('#CurrentPassword').focus();
        });
    </script>
}
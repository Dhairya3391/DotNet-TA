@model MinuteOfMeeting.Controllers.RegisterViewModel
@{
    ViewData["Title"] = "Register";
    ViewData["PageTitle"] = "Register";
    ViewData["PageDescription"] = "Create a new account to access the Minutes of Meeting Management System";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-lg">
            <div class="card-header text-center">
                <h4 class="mb-0">
                    <i class="bi bi-person-plus me-2"></i>
                    Create New Account
                </h4>
            </div>
            <div class="card-body">
                <form asp-action="Register" method="post">
                    @Html.AntiForgeryToken()

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="Username" class="form-label fw-bold"></label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-person"></i>
                                    </span>
                                    <input asp-for="Username" class="form-control" placeholder="Choose a username" autocomplete="username" />
                                </div>
                                <span asp-validation-for="Username" class="text-danger"></span>
                                <small class="text-muted">Username must be 3-50 characters long.</small>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="Role" class="form-label fw-bold"></label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-shield"></i>
                                    </span>
                                    <select asp-for="Role" class="form-select" id="roleSelect">
                                        <option value="">-- Select Role --</option>
                                        <option value="Admin">Admin</option>
                                        <option value="Organizer">Organizer</option>
                                        <option value="Staff">Staff</option>
                                    </select>
                                </div>
                                <span asp-validation-for="Role" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="Password" class="form-label fw-bold"></label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-key"></i>
                                    </span>
                                    <input asp-for="Password" class="form-control" type="password" placeholder="Create password" autocomplete="new-password" />
                                </div>
                                <span asp-validation-for="Password" class="text-danger"></span>
                                <small class="text-muted">Password must be at least 6 characters long.</small>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="ConfirmPassword" class="form-label fw-bold"></label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-key-fill"></i>
                                    </span>
                                    <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="Confirm password" autocomplete="new-password" />
                                </div>
                                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="StaffID" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-person-badge"></i>
                            </span>
                            <select asp-for="StaffID" class="form-select" id="staffSelect">
                                <option value="">-- Optional: Link to Staff Member --</option>
                                @if (ViewBag.Departments != null)
                                {
                                    foreach (var dept in ViewBag.Departments)
                                    {
                                        <option value="@dept.Value">@dept.Text</option>
                                    }
                                }
                            </select>
                        </div>
                        <span asp-validation-for="StaffID" class="text-danger"></span>
                        <small class="text-muted">Optional: Link this account to a staff member for better tracking.</small>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="bi bi-person-plus me-2"></i>
                            Create Account
                        </button>
                        <a asp-action="Login" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-2"></i>
                            Back to Login
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        $(document).ready(function() {
            // Real-time username availability check
            $('#Username').on('blur', function() {
                var username = $(this).val().trim();

                if (username.length >= 3) {
                    $.post('/Account/CheckUsername', { username: username }, function(response) {
                        if (response.error) {
                            // Handle error case
                            return;
                        }

                        var feedback = $('#Username').siblings('.username-feedback');
                        if (feedback.length === 0) {
                            feedback = $('<div class="username-feedback mt-1 small"></div>');
                            $('#Username').parent().append(feedback);
                        }

                        if (response.available) {
                            feedback.removeClass('text-danger').addClass('text-success')
                                .text('Username is available!');
                        } else {
                            feedback.removeClass('text-success').addClass('text-danger')
                                .text('Username is already taken!');
                        }
                    });
                }
            });

            // Focus on username field
            $('#Username').focus();
        });
    </script>
}
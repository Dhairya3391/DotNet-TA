@model MinuteOfMeeting.Controllers.LoginViewModel
@{
    ViewData["Title"] = "Login";
    ViewData["PageTitle"] = "Login";
    ViewData["PageDescription"] = "Sign in to access the Minutes of Meeting Management System";
}

<div class="columns is-centered">
    <div class="column is-5-tablet is-4-desktop is-4-widescreen">
        <!-- Login Form Card -->
        <div class="card">
            <header class="card-header has-background-primary">
                <div class="card-header-title is-centered has-text-white">
                    <span class="icon is-medium">
                        <i class="fas fa-sign-in-alt"></i>
                    </span>
                    <span class="ml-2">User Login</span>
                </div>
            </header>
            <div class="card-content">
                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()

                    <div class="field">
                        <label asp-for="Username" class="label"></label>
                        <div class="control has-icons-left">
                            <input asp-for="Username" class="input" type="text"
                                   placeholder="Enter your username" autocomplete="username" />
                            <span class="icon is-small is-left">
                                <i class="fas fa-user"></i>
                            </span>
                        </div>
                        <span asp-validation-for="Username" class="help is-danger"></span>
                    </div>

                    <div class="field">
                        <label asp-for="Password" class="label"></label>
                        <div class="control has-icons-left">
                            <input asp-for="Password" id="PasswordField" class="input" type="password"
                                   placeholder="Enter your password" autocomplete="current-password" />
                            <span class="icon is-small is-left">
                                <i class="fas fa-lock"></i>
                            </span>
                        </div>
                        <span asp-validation-for="Password" class="help is-danger"></span>
                    </div>

                    <div class="field">
                        <div class="control">
                            <label class="checkbox">
                                <input asp-for="RememberMe" />
                                <span>@Html.DisplayNameFor(m => m.RememberMe)</span>
                            </label>
                        </div>
                    </div>

                    <div class="field">
                        <div class="control">
                            <button type="submit" class="button is-primary is-fullwidth is-medium">
                                <span class="icon">
                                    <i class="fas fa-sign-in-alt"></i>
                                </span>
                                <span>Sign In</span>
                            </button>
                        </div>
                    </div>

                    <div class="has-text-centered">
                        <p class="is-size-6">
                            Don't have an account?
                            <a asp-action="Register" class="has-text-primary has-text-weight-semibold">
                                Register here
                            </a>
                        </p>
                    </div>
                </form>
            </div>
        </div>

        <!-- Demo Credentials Card -->
        <div class="card mt-4">
            <header class="card-header has-background-info">
                <div class="card-header-title is-centered has-text-white">
                    <span class="icon is-small">
                        <i class="fas fa-info-circle"></i>
                    </span>
                    <span class="ml-2">Demo Credentials</span>
                </div>
            </header>
            <div class="card-content">
                <div class="content">
                    <div class="field">
                        <div class="control">
                            <div class="notification is-light is-info">
                                <span class="icon">
                                    <i class="fas fa-user-shield"></i>
                                </span>
                                <strong>Admin:</strong> username: <code>admin</code>, password: <code>admin123</code>
                            </div>
                        </div>
                    </div>
                    <div class="field">
                        <div class="control">
                            <div class="notification is-light is-warning">
                                <span class="icon">
                                    <i class="fas fa-user-tie"></i>
                                </span>
                                <strong>Organizer:</strong> username: <code>organizer</code>, password: <code>org123</code>
                            </div>
                        </div>
                    </div>
                    <div class="field">
                        <div class="control">
                            <div class="notification is-light is-success">
                                <span class="icon">
                                    <i class="fas fa-user"></i>
                                </span>
                                <strong>Staff:</strong> username: <code>staff</code>, password: <code>staff123</code>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Toggle password visibility
            const passwordField = document.getElementById('PasswordField');
            const passwordContainer = passwordField.closest('.control');

            // Create toggle button
            const toggleButton = document.createElement('button');
            toggleButton.type = 'button';
            toggleButton.className = 'button is-small is-right';
            toggleButton.innerHTML = '<span class="icon"><i class="fas fa-eye" id="passwordIcon"></i></span>';
            toggleButton.style.position = 'absolute';
            toggleButton.style.right = '0';
            toggleButton.style.top = '0';
            toggleButton.style.height = '100%';
            toggleButton.style.border = 'none';
            toggleButton.style.background = 'transparent';
            toggleButton.style.cursor = 'pointer';
            toggleButton.style.zIndex = '10';

            // Make control container relative for button positioning
            passwordContainer.style.position = 'relative';
            passwordContainer.appendChild(toggleButton);

            toggleButton.addEventListener('click', function() {
                const passwordIcon = document.getElementById('passwordIcon');

                if (passwordField.type === 'password') {
                    passwordField.type = 'text';
                    passwordIcon.className = 'fas fa-eye-slash';
                } else {
                    passwordField.type = 'password';
                    passwordIcon.className = 'fas fa-eye';
                }
            });

            // Focus on username field
            const usernameField = document.getElementById('Username');
            if (usernameField) {
                usernameField.focus();
            }

            // Add form submission enhancement
            const form = document.querySelector('form');
            form.addEventListener('submit', function() {
                const submitButton = form.querySelector('button[type="submit"]');
                submitButton.classList.add('is-loading');
                submitButton.disabled = true;
            });
        });
    </script>
}
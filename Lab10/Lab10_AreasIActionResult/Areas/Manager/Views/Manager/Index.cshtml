@{
    ViewData["Title"] = "Manager Area";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">
    <div class="row">
        <div class="col-md-12">
            <div class="card border-success">
                <div class="card-header bg-success text-white">
                    <h2 class="mb-0">@ViewBag.Message</h2>
                </div>
                <div class="card-body">
                    <p class="lead">Manager dashboard for team and project management.</p>

                    <div class="row mt-4">
                        <div class="col-md-4">
                            <div class="card border-primary">
                                <div class="card-header bg-primary text-white">
                                    <h6 class="mb-0">Team Statistics</h6>
                                </div>
                                <div class="card-body">
                                    <ul class="list-unstyled">
                                        <li><strong>Team Size:</strong> @ViewBag.TeamSize</li>
                                        <li><strong>Department:</strong> @ViewBag.Department</li>
                                        <li><strong>Active Projects:</strong> 3</li>
                                        <li><strong>Team Performance:</strong> 87%</li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="card border-info">
                                <div class="card-header bg-info text-white">
                                    <h6 class="mb-0">IActionResult Types</h6>
                                </div>
                                <div class="card-body">
                                    <ul class="list-unstyled">
                                        <li><strong>View:</strong> Render Razor views</li>
                                        <li><strong>Content:</strong> Return raw content</li>
                                        <li><strong>JSON:</strong> Return JSON data</li>
                                        <li><strong>File:</strong> Download files</li>
                                        <li><strong>Redirect:</strong> Navigate to URLs</li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="card border-warning">
                                <div class="card-header bg-warning text-dark">
                                    <h6 class="mb-0">Status Codes</h6>
                                </div>
                                <div class="card-body">
                                    <ul class="list-unstyled">
                                        <li><strong>200:</strong> Success</li>
                                        <li><strong>404:</strong> Not Found</li>
                                        <li><strong>401:</strong> Unauthorized</li>
                                        <li><strong>403:</strong> Forbidden</li>
                                        <li><strong>400:</strong> Bad Request</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mt-4">
                        <div class="col-md-12">
                            <h5>Manager Area Demonstrations</h5>
                            <div class="row">
                                <div class="col-md-6">
                                    <h6>Content & Data Results</h6>
                                    <div class="list-group">
                                        <a asp-action="ContentDemo" class="list-group-item list-group-item-action">
                                            <small>Content Result → XML Data</small>
                                        </a>
                                        <a asp-action="JsonDemo" class="list-group-item list-group-item-action">
                                            <small>JSON Result → Team & Project Data</small>
                                        </a>
                                        <a asp-action="FileDemo" class="list-group-item list-group-item-action">
                                            <small>File Result → CSV Report</small>
                                        </a>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <h6>Navigation & Status Results</h6>
                                    <div class="list-group">
                                        <a asp-action="RedirectDemo" class="list-group-item list-group-item-action">
                                            <small>Redirect → Employee Area</small>
                                        </a>
                                        <a asp-action="StatusCodeDemo" class="list-group-item list-group-item-action list-group-item-success">
                                            <small>202 Accepted</small>
                                        </a>
                                        <a asp-action="NotFoundDemo" class="list-group-item list-group-item-action list-group-item-warning">
                                            <small>404 Not Found</small>
                                        </a>
                                        <a asp-action="ForbiddenDemo" class="list-group-item list-group-item-action list-group-item-danger">
                                            <small>403 Forbidden</small>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-success mt-4">
                        <h5>Manager Area Features</h5>
                        <div class="row">
                            <div class="col-md-6">
                                <ul>
                                    <li>Team management capabilities</li>
                                    <li>Project oversight tools</li>
                                    <li>Performance monitoring</li>
                                </ul>
                            </div>
                            <div class="col-md-6">
                                <ul>
                                    <li>Resource allocation</li>
                                    <li>Report generation</li>
                                    <li>Cross-area navigation</li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4">
                        <a asp-area="Admin" asp-controller="Admin" asp-action="Index" class="btn btn-outline-danger me-2">Admin Area</a>
                        <a asp-area="Employee" asp-controller="Employee" asp-action="Index" class="btn btn-outline-success me-2">Employee Area</a>
                        <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Main Site</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>